cMontaner Juan\u201d\uff0clocation\u662f\u201cGENEVE\u201d\u3002\\n\\n\u63a5\u4e0b\u6765\u662fb_id\uff0c\u901a\u5e38\u5728\u53f3\u4e0a\u89d2\u3002\u56fe\u7247\u53f3\u4e0a\u89d2\u6709\u201cB.51.322.GB.377.\u201d\uff0c\u6240\u4ee5b_id\u7684transcription\u5c31\u662f\u8fd9\u4e2a\u5b57\u7b26\u4e32\u3002\\n\\n\u65e5\u671f\u65b9\u9762\uff0c\u9700\u8981\u627e\u4efb\u4f55\u76d6\u7ae0\u6216\u624b\u5199\u7684\u65e5\u671f\u3002\u5728\u4fe1\u606f\u90e8\u5206\u6709\u201cAmendment 14, v.25.8.41.\u201d\uff0c\u8fd9\u91cc\u7684\u65e5\u671f\u662f25.8.41\uff0c\u8f6c\u6362\u6210YYYY-MM-DD\u683c\u5f0f\u5e94\u8be5\u662f1941-08-25\u3002\u53e6\u5916\uff0c\u8fd8\u6709\u201cgestrichen: Amendment 7, 18.6.1945.\u201d\uff0c\u8fd9\u91cc\u6709\u4e00\u4e2a1945-06-18\u7684\u65e5\u671f\u3002\u4f46\u7528\u6237\u8981\u6c42\u7684\u662f\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u591a\u4e2a\u65e5\u671f\u3002\u4e0d\u8fc7\u6839\u636e\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u6700\u660e\u663e\u7684\u65e5\u671f\u3002\u6216\u8005\u53ef\u80fd\u4e24\u4e2a\u65e5\u671f\u90fd\u9700\u8981\u8003\u8651\uff1f\u4f46\u7528\u6237\u8bf4\u660e\u4e2d\u63d0\u5230\u201cany stamped dates\u201d\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\u3002\u4e0d\u8fc7\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\uff1f\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u4e0d\u662f\u6570\u7ec4\u3002\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u4e2a\u65e5\u671f\u662f1941-08-25\uff0c\u7b2c\u4e8c\u4e2a\u662f1945-06-18\u3002\u4f46\u539f\u5361\u7247\u4e2d\u7684\u201cv.25.8.41\u201d\u53ef\u80fd\u8868\u793a\u7248\u672c\u65e5\u671f\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f\u5220\u9664\u7684\u65e5\u671f\u3002\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u8003\u8651\uff0c\u4f46\u6839\u636e\u7528\u6237\u6307\u793a\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\u6210\u4e00\u4e2a\u5b57\u7b26\u4e32\uff1f\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u6700\u76f8\u5173\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\uff0c\u4f46\u683c\u5f0f\u53ef\u80fd\u4e0d\u5141\u8bb8\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u201cAmendment 14, v.25.8.41.\u201d\u4e2d\u7684\u65e5\u671f\u662f1941\u5e748\u670825\u65e5\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f1945\u5e746\u670818\u65e5\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\u65e5\u671f\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u63d0\u53d6\uff0c\u4f46JSON\u4e2d\u7684date\u5b57\u6bb5\u53ea\u80fd\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u653e\u5728date\u5b57\u6bb5\u4e2d\uff0c\u7528\u5206\u53f7\u5206\u9694\uff1f\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\uff0c\u4f46\u6839\u636e\u63d0\u4f9b\u7684JSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5c06\u4e24\u4e2a\u65e5\u671f\u7528\u9017\u53f7\u5206\u9694\u3002\u4f46\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u7a7a\u5b57\u7b26\u4e32\uff0c\u5982\u679c\u6ca1\u6709\u65e5\u671f\u7684\u8bdd\u3002\u4f46\u5728\u8fd9\u4e2a\u6848\u4f8b\u4e2d\uff0c\u5b58\u5728\u4e24\u4e2a\u65e5\u671f\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u7b2c\u4e00\u4e2a\u6216\u8005\u6700\u540e\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u53ef\u80fd\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u4f46date\u5b57\u6bb5\u9700\u8981\u63d0\u53d6\u6240\u6709\u51fa\u73b0\u7684\u65e5\u671f\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5c06\u4e24\u4e2a\u65e5\u671f\u7528\u5206\u53f7\u5206\u9694\u3002\u4f46\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u7a7a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u660e\u786e\u7684\u65e5\u671f\u6233\u3002\u4f8b\u5982\uff0c\u5728\u5361\u7247\u4e0a\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u201cv.25.8.41\u201d\u53ef\u80fd\u662f\u4e00\u4e2a\u7248\u672c\u65e5\u671f\uff0c\u800c\u201c18.6.1945\u201d\u662f\u5220\u9664\u7684\u65e5\u671f\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u63d0\u53d6\u5230date\u5b57\u6bb5\u4e2d\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u201cAmendment 14, v.25.8.41.\u201d\u4e2d\u7684\u65e5\u671f\u662f1941\u5e74\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f1945\u5e74\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u90fd\u63d0\u53d6\u3002\u4f46\u6839\u636e\u63d0\u4f9b\u7684JSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u6700\u660e\u663e\u7684\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u4f8b\u5982\uff0c1941-08-25\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\uff0c\u4f46\u9700\u8981\u786e\u8ba4\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u6839\u636e\u793a\u4f8b\u6765\u5224\u65ad\u3002\u4f8b\u5982\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0c\u5982\u679c\u5361\u7247\u4e0a\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u5e94\u8be5\u5982\u4f55\u5904\u7406\u3002\u4f46\u7528\u6237\u6ca1\u6709\u7ed9\u51fa\u793a\u4f8b\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u6839\u636e\u5e38\u89c4\u505a\u6cd5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9009\u62e9\u6700\u8fd1\u7684\u6216\u8005\u6700\u65e9\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u90fd\u63d0\u53d6\uff0c\u7528\u5206\u53f7\u5206\u9694\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u4ee5\u8fd9\u6837\u505a\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25, 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u9009\u62e91941-08-25\u3002\u4f46\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cany stamped dates on the card in YYYY-MM-DD format. If no date is present, use an empty string.\u201d\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u5e94\u8be5\u90fd\u63d0\u53d6\uff0c\u4f46\u5982\u4f55\u653e\u5728\u4e00\u4e2a\u5b57\u7b26\u4e32\u4e2d\uff1f\u53ef\u80fd\u9700\u8981\u7528\u5206\u53f7\u5206\u9694\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u65e5\u671f\u3002\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u5728\u53f3\u4e0b\u89d2\u6709\u624b\u5199\u7684\u201cSuppl. 6, 31.8.45\u201d\uff0c\u8fd9\u53ef\u80fd\u4e5f\u662f\u4e00\u4e2a\u65e5\u671f\uff0c\u53731945-08-31\u3002\u4f46\u7528\u6237\u53ef\u80fd\u53ea\u5173\u6ce8\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u800c\u624b\u5199\u7684\u53ef\u80fd\u4e0d\u7b97\u3002\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cany stamped dates\u201d\uff0c\u6240\u4ee5\u624b\u5199\u7684\u65e5\u671f\u53ef\u80fd\u4e0d\u7b97\u3002\u4f8b\u5982\uff0c\u201cgestrichen: Amendment 7, 18.6.1945.\u201d\u4e2d\u7684\u65e5\u671f\u662f\u6253\u5370\u7684\u8fd8\u662f\u624b\u5199\u7684\uff1f\u5728\u56fe\u7247\u4e2d\uff0c\u201cgestrichen\u201d\u90e8\u5206\u662f\u6253\u5370\u7684\uff0c\u800c\u4e0b\u9762\u7684\u201cfig...\u201d\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u201c18.6.1945\u201d\u662f\u6253\u5370\u7684\uff0c\u5c5e\u4e8estamped dates\u3002\u800c\u201cSuppl. 6, 31.8.45\u201d\u662f\u624b\u5199\u7684\uff0c\u53ef\u80fd\u4e0d\u7b97\u3002\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u62ec1941-08-25\u548c1945-06-18\u3002\u4f46\u5982\u4f55\u5408\u5e76\u8fd9\u4e24\u4e2a\u65e5\u671f\uff1f\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u7528\u5206\u53f7\u5206\u9694\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u9009\u62e91941-08-25\u3002\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u5e94\u8be5\u63d0\u53d6\u6240\u6709\u5b58\u5728\u7684\u65e5\u671f\u3002\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u4ee5\u8fd9\u6837\u505a\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25, 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u4fdd\u683c\u5f0f\u6b63\u786e\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u6bb5\uff0c\u6240\u4ee5\u5fc5\u987b\u5408\u5e76\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u65e5\u671f\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u6b63\u786e\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u201cAmendment 14, v.25.8.41.\u201d\u4e2d\u7684\u65e5\u671f\u662f1941\u5e748\u670825\u65e5\uff0c\u800c\u201cgestrichen: Amendment 7, 18.6.1945.\u201d\u4e2d\u7684\u65e5\u671f\u662f1945\u5e746\u670818\u65e5\u3002\u6240\u4ee5\u8fd9\u4e24\u4e2a\u65e5\u671f\u90fd\u662fstamped\u7684\uff0c\u5e94\u8be5\u88ab\u63d0\u53d6\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u8be5\u662f\u8fd9\u4e24\u4e2a\u65e5\u671f\u7684\u7ec4\u5408\u3002\u4f46\u5982\u4f55\u683c\u5f0f\u5316\uff1f\u4f8b\u5982\uff0c\u7528\u5206\u53f7\u5206\u9694\u3002\u6240\u4ee5date: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u5fc5\u987b\u5408\u5e76\u3002\u56e0\u6b64\uff0c\u6b63\u786e\u7684\u505a\u6cd5\u662f\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\uff0c\u7528\u5206\u53f7\u5206\u9694\u3002\\n\\n\u63a5\u4e0b\u6765\u662finformation\u90e8\u5206\uff0c\u9700\u8981\u63d0\u53d6\u4e3b\u6587\u672c\u5757\u3002\u5361\u7247\u4e0a\u7684\u4e3b\u8981\u6587\u672c\u5305\u62ec\uff1a\\n\\n- \\\"Britische schwarze Liste\\\\nAmendment 14, v.25.8.41.\\\"\\n- \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"\\n- \u624b\u5199\u7684\u201cfig und auf franz. liste\u201d\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\u63d0\u53d6\uff0c\u56e0\u4e3a\u7528\u6237\u53ef\u80fd\u53ea\u9700\u8981\u6253\u5370\u7684\u6587\u672c\u3002\u4f46\u9700\u8981\u786e\u8ba4\u3002\u7528\u6237\u8bf4\u201ctext blocks from the main body of the card\u201d\uff0c\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u88ab\u5212\u6389\u7684\u53ef\u80fd\u4e0d\u7b97\u3002\u4f8b\u5982\uff0c\u624b\u5199\u7684\u90e8\u5206\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u8868\u793a\u65e0\u6548\uff0c\u6240\u4ee5\u4e0d\u63d0\u53d6\u3002\u800c\u201cSuppl. 6, 31.8.45\u201d\u662f\u624b\u5199\u7684\uff0c\u53ef\u80fd\u4e5f\u4e0d\u7b97\u3002\u6240\u4ee5information\u90e8\u5206\u5e94\u8be5\u5305\u62ec\uff1a\\n\\n1. \\\"Britische schwarze Liste\\\\nAmendment 14, v.25.8.41.\\\"\\n2. \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"\\n\\n\u53e6\u5916\uff0c\u5de6\u4e0b\u89d2\u6709\u201c35272\u201d\uff0c\u4f46\u53ef\u80fd\u5c5e\u4e8e\u5176\u4ed6\u4fe1\u606f\uff0c\u4e0d\u5c5e\u4e8e\u4e3b\u6587\u672c\u5757\u3002\u6240\u4ee5information\u6570\u7ec4\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u6761\u76ee\u3002\\n\\n\u73b0\u5728\u9700\u8981\u5c06\u8fd9\u4e9b\u4fe1\u606f\u6574\u7406\u6210JSON\u683c\u5f0f\uff0c\u786e\u4fdd\u6bcf\u4e2a\u5b57\u6bb5\u6b63\u786e\u3002\u4f8b\u5982\uff1a\\n\\ncompany: {\\\"transcription\\\": \\\"Montaner Juan\\\"}\\nlocation: {\\\"transcription\\\": \\\"GENEVE\\\"}\\nb_id: {\\\"transcription\\\": \\\"B.51.322.GB.377.\\\"}\\ndate: \\\"1941-08-25; 1945-06-18\\\"\\ninformation: [\\n  {\\\"transcription\\\": \\\"Britische schwarze Liste\\\\nAmendment 14, v.25.8.41.\\\"},\\n  {\\\"transcription\\\": \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"}\\n]\\n\\n\u4f46\u9700\u8981\u68c0\u67e5\u65e5\u671f\u662f\u5426\u6b63\u786e\u8f6c\u6362\u3002\u4f8b\u5982\uff0c25.8.41\u662f1941\u5e748\u670825\u65e5\uff0c\u6b63\u786e\u300218.6.1945\u662f1945\u5e746\u670818\u65e5\uff0c\u6b63\u786e\u3002\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u662f\u8fd9\u4e24\u4e2a\u65e5\u671f\u7684\u7ec4\u5408\uff0c\u7528\u5206\u53f7\u5206\u9694\u3002\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u5fc5\u987b\u5408\u5e76\u3002\u56e0\u6b64\uff0c\u6b63\u786e\u7684\u505a\u6cd5\u662f\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\u3002\\n\\n\u53e6\u5916\uff0c\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u53f3\u4e0b\u89d2\u7684\u201cSuppl. 6, 31.8.45\u201d\u662f\u624b\u5199\u7684\uff0c\u53ef\u80fd\u4e0d\u7b97stamped dates\uff0c\u6240\u4ee5\u4e0d\u5305\u62ec\u5728date\u5b57\u6bb5\u4e2d\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u53ea\u5305\u62ec1941-08-25\u548c1945-06-18\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fdd\u6240\u6709\u5b57\u6bb5\u90fd\u6b63\u786e\u586b\u5199\uff0c\u6ca1\u6709\u9057\u6f0f\u3002\u4f8b\u5982\uff0ccompany\u662f\u5426\u6b63\u786e\uff0clocation\u662f\u5426\u6b63\u786e\uff0cb_id\u662f\u5426\u6b63\u786e\uff0cdate\u662f\u5426\u6b63\u786e\uff0cinformation\u662f\u5426\u6b63\u786e\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u7d22\u5f15\u5361\u7247\u56fe\u50cf\uff0c\u5e76\u63d0\u53d6\u6240\u9700\u7684\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u8981\u4ed4\u7ec6\u67e5\u770b\u56fe\u7247\u4e2d\u7684\u5404\u4e2a\u90e8\u5206\uff0c\u786e\u4fdd\u6b63\u786e\u8bc6\u522b\u6bcf\u4e2a\u5b57\u6bb5\u3002\\n\\n\u9996\u5148\u770b\u516c\u53f8\u90e8\u5206\u3002\u56fe\u7247\u5de6\u4e0a\u89d2\u663e\u793a\u7684\u662f\u201cMontaner Juan, rue vieux coll\u00e8ge, GENEVE\u201d\u3002\u8fd9\u91cc\u516c\u53f8\u540d\u5e94\u8be5\u662f\u201cMontaner Juan\u201d\uff0c\u800c\u4f4d\u7f6e\u662f\u201cGENEVE\u201d\u3002\u6240\u4ee5company\u5b57\u6bb5\u5e94\u8be5\u662f\u201cMontaner Juan\u201d\uff0clocation\u662f\u201cGENEVE\u201d\u3002\\n\\n\u63a5\u4e0b\u6765\u662fb_id\uff0c\u901a\u5e38\u5728\u53f3\u4e0a\u89d2\u3002\u56fe\u7247\u53f3\u4e0a\u89d2\u6709\u201cB.51.322.GB.377.\u201d\uff0c\u6240\u4ee5b_id\u7684transcription\u5c31\u662f\u8fd9\u4e2a\u5b57\u7b26\u4e32\u3002\\n\\n\u65e5\u671f\u65b9\u9762\uff0c\u9700\u8981\u627e\u4efb\u4f55\u76d6\u7ae0\u6216\u624b\u5199\u7684\u65e5\u671f\u3002\u5728\u4fe1\u606f\u90e8\u5206\u6709\u201cAmendment 14, v.25.8.41.\u201d\uff0c\u8fd9\u91cc\u7684\u65e5\u671f\u662f25.8.41\uff0c\u8f6c\u6362\u6210YYYY-MM-DD\u683c\u5f0f\u5e94\u8be5\u662f1941-08-25\u3002\u53e6\u5916\uff0c\u8fd8\u6709\u201cgestrichen: Amendment 7, 18.6.1945.\u201d\uff0c\u8fd9\u91cc\u6709\u4e00\u4e2a1945-06-18\u7684\u65e5\u671f\u3002\u4f46\u7528\u6237\u8981\u6c42\u7684\u662f\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u591a\u4e2a\u65e5\u671f\u3002\u4e0d\u8fc7\u6839\u636e\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u6700\u660e\u663e\u7684\u65e5\u671f\u3002\u6216\u8005\u53ef\u80fd\u4e24\u4e2a\u65e5\u671f\u90fd\u9700\u8981\u8003\u8651\uff1f\u4f46\u7528\u6237\u8bf4\u660e\u4e2d\u63d0\u5230\u201cany stamped dates\u201d\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\u3002\u4e0d\u8fc7\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\uff1f\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u4e0d\u662f\u6570\u7ec4\u3002\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u4e2a\u65e5\u671f\u662f1941-08-25\uff0c\u7b2c\u4e8c\u4e2a\u662f1945-06-18\u3002\u4f46\u539f\u5361\u7247\u4e2d\u7684\u201cv.25.8.41\u201d\u53ef\u80fd\u8868\u793a\u7248\u672c\u65e5\u671f\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f\u5220\u9664\u7684\u65e5\u671f\u3002\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u8003\u8651\uff0c\u4f46\u6839\u636e\u7528\u6237\u6307\u793a\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\u6210\u4e00\u4e2a\u5b57\u7b26\u4e32\uff1f\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u6700\u76f8\u5173\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\uff0c\u4f46\u683c\u5f0f\u53ef\u80fd\u4e0d\u5141\u8bb8\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u201cAmendment 14, v.25.8.41.\u201d\u4e2d\u7684\u65e5\u671f\u662f1941\u5e748\u670825\u65e5\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f1945\u5e746\u670818\u65e5\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\u65e5\u671f\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u63d0\u53d6\uff0c\u4f46JSON\u4e2d\u7684date\u5b57\u6bb5\u53ea\u80fd\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u653e\u5728date\u5b57\u6bb5\u4e2d\uff0c\u7528\u5206\u53f7\u5206\u9694\uff1f\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\uff0c\u4f46\u6839\u636e\u63d0\u4f9b\u7684JSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5c06\u4e24\u4e2a\u65e5\u671f\u7528\u9017\u53f7\u5206\u9694\u3002\u4f46\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u7a7a\u5b57\u7b26\u4e32\uff0c\u5982\u679c\u6ca1\u6709\u65e5\u671f\u7684\u8bdd\u3002\u4f46\u5728\u8fd9\u4e2a\u6848\u4f8b\u4e2d\uff0c\u5b58\u5728\u4e24\u4e2a\u65e5\u671f\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u9009\u62e9\u7b2c\u4e00\u4e2a\u6216\u8005\u6700\u540e\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u53ef\u80fd\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u4f46date\u5b57\u6bb5\u9700\u8981\u63d0\u53d6\u6240\u6709\u51fa\u73b0\u7684\u65e5\u671f\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f8b\u5982\uff0c\u5c06\u4e24\u4e2a\u65e5\u671f\u7528\u5206\u53f7\u5206\u9694\u3002\u4f46\u539f\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u7a7a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u660e\u786e\u7684\u65e5\u671f\u6233\u3002\u4f8b\u5982\uff0c\u5728\u5361\u7247\u4e0a\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u201cv.25.8.41\u201d\u53ef\u80fd\u662f\u4e00\u4e2a\u7248\u672c\u65e5\u671f\uff0c\u800c\u201c18.6.1945\u201d\u662f\u5220\u9664\u7684\u65e5\u671f\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u63d0\u53d6\u5230date\u5b57\u6bb5\u4e2d\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u201cAmendment 14, v.25.8.41.\u201d\u4e2d\u7684\u65e5\u671f\u662f1941\u5e74\uff0c\u800c\u201cgestrichen\u201d\u90e8\u5206\u7684\u65e5\u671f\u662f1945\u5e74\u3002\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u91cd\u8981\u7684\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u90fd\u63d0\u53d6\u3002\u4f46\u6839\u636e\u63d0\u4f9b\u7684JSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u6700\u660e\u663e\u7684\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u4f8b\u5982\uff0c1941-08-25\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\uff0c\u4f46\u9700\u8981\u786e\u8ba4\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u6839\u636e\u793a\u4f8b\u6765\u5224\u65ad\u3002\u4f8b\u5982\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0c\u5982\u679c\u5361\u7247\u4e0a\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u5e94\u8be5\u5982\u4f55\u5904\u7406\u3002\u4f46\u7528\u6237\u6ca1\u6709\u7ed9\u51fa\u793a\u4f8b\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u6839\u636e\u5e38\u89c4\u505a\u6cd5\u3002\u4f8b\u5982\uff0c\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9009\u62e9\u6700\u8fd1\u7684\u6216\u8005\u6700\u65e9\u7684\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u6240\u6709\u65e5\u671f\u90fd\u63d0\u53d6\uff0c\u7528\u5206\u53f7\u5206\u9694\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u4ee5\u8fd9\u6837\u505a\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25, 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u9009\u62e91941-08-25\u3002\u4f46\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cany stamped dates on the card in YYYY-MM-DD format. If no date is present, use an empty string.\u201d\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u5e94\u8be5\u90fd\u63d0\u53d6\uff0c\u4f46\u5982\u4f55\u653e\u5728\u4e00\u4e2a\u5b57\u7b26\u4e32\u4e2d\uff1f\u53ef\u80fd\u9700\u8981\u7528\u5206\u53f7\u5206\u9694\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u65e5\u671f\u3002\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u5728\u53f3\u4e0b\u89d2\u6709\u624b\u5199\u7684\u201cSuppl. 6, 31.8.45\u201d\uff0c\u8fd9\u53ef\u80fd\u4e5f\u662f\u4e00\u4e2a\u65e5\u671f\uff0c\u53731945-08-31\u3002\u4f46\u7528\u6237\u53ef\u80fd\u53ea\u5173\u6ce8\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u800c\u624b\u5199\u7684\u53ef\u80fd\u4e0d\u7b97\u3002\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cany stamped dates\u201d\uff0c\u6240\u4ee5\u624b\u5199\u7684\u65e5\u671f\u53ef\u80fd\u4e0d\u7b97\u3002\u4f8b\u5982\uff0c\u201cgestrichen: Amendment 7, 18.6.1945.\u201d\u4e2d\u7684\u65e5\u671f\u662f\u6253\u5370\u7684\u8fd8\u662f\u624b\u5199\u7684\uff1f\u5728\u56fe\u7247\u4e2d\uff0c\u201cgestrichen\u201d\u90e8\u5206\u662f\u6253\u5370\u7684\uff0c\u800c\u4e0b\u9762\u7684\u201cfig...\u201d\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u201c18.6.1945\u201d\u662f\u6253\u5370\u7684\uff0c\u5c5e\u4e8estamped dates\u3002\u800c\u201cSuppl. 6, 31.8.45\u201d\u662f\u624b\u5199\u7684\uff0c\u53ef\u80fd\u4e0d\u7b97\u3002\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u62ec1941-08-25\u548c1945-06-18\u3002\u4f46\u5982\u4f55\u5408\u5e76\u8fd9\u4e24\u4e2a\u65e5\u671f\uff1f\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u7528\u5206\u53f7\u5206\u9694\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25; 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u7b26\u5408\u7528\u6237\u7684\u8981\u6c42\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u53ea\u63d0\u53d6\u4e00\u4e2a\u65e5\u671f\uff0c\u6bd4\u5982\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u9009\u62e91941-08-25\u3002\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u5e94\u8be5\u63d0\u53d6\u6240\u6709\u5b58\u5728\u7684\u65e5\u671f\u3002\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u5b83\u4eec\u5408\u5e76\u3002\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u4ee5\u8fd9\u6837\u505a\u3002\u4f8b\u5982\uff0cdate: \\\"1941-08-25, 1945-06-18\\\"\u3002\u4f46\u9700\u8981\u786e\u4fdd\u683c\u5f0f\u6b63\u786e\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u6bcf\u4e2a\u65e5\u671f\u5355\u72ec\u5904\u7406\uff0c\u4f46\u6839\u636eJSON\u7ed3\u6784\uff0cdate\u662f\u5355\u4e2a\u5b57\u6bb5\uff0c\u6240\u4ee5\u5fc5\u987b\u5408\u5e76\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u5305\u62ec\u8fdb\u53bb\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u606f\u90e8\u5206\uff0c\u6709\u4e24\u4e2a\u65e5\u671f\uff0c\u6240\u4ee5date\u5b57\u6bb5\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u65e5\u671f\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u6b63\u786e\u3002\u4f8b\u5982\uff0c\u539f\u5361
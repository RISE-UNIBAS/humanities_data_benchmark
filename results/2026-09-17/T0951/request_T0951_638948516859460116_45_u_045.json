82\u679c\u6ca1\u6709\u660e\u786e\u7684\u76d6\u7ae0\u65e5\u671f\uff0c\u53ef\u80fd\u7559\u7a7a\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u5224\u65ad\uff0c\u5982\u679c\u7528\u6237\u63d0\u4f9b\u7684\u4f8b\u5b50\u4e2d\u65e5\u671f\u662f\u6587\u672c\u4e2d\u7684\uff0c\u662f\u5426\u5e94\u8be5\u63d0\u53d6\u3002\u6839\u636e\u7528\u6237\u8bf4\u660e\uff0cdate\u662f\u201c\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6ca1\u6709\u76d6\u7ae0\uff0c\u5c31\u7559\u7a7a\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fddJSON\u7ed3\u6784\u6b63\u786e\uff0c\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u6709\u5bf9\u5e94\u7684transcription\uff0c\u4fe1\u606f\u90e8\u5206\u6b63\u786e\u5206\u5757\uff0c\u6ca1\u6709\u9057\u6f0f\u3002\\n\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u7d22\u5f15\u5361\u56fe\u50cf\uff0c\u5e76\u63d0\u53d6\u6240\u9700\u7684\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u8981\u4ed4\u7ec6\u5206\u6790\u7528\u6237\u7684\u8981\u6c42\uff0c\u786e\u4fdd\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u6b63\u786e\u5bf9\u5e94\u3002\\n\\n\u9996\u5148\u770b\u516c\u53f8\u90e8\u5206\uff0c\u7528\u6237\u63d0\u5230\u516c\u53f8\u540d\u901a\u5e38\u5728\u5de6\u4e0a\u89d2\uff0c\u4e0d\u5305\u62ec\u5730\u70b9\u3002\u56fe\u50cf\u4e2d\u7684\u5de6\u4e0a\u89d2\u662f\u201cRitzi & Wagner, St.Gallen (Amriswil)\u3002\u201d\u8fd9\u91cc\u9700\u8981\u6ce8\u610f\uff0cSt.Gallen\u662f\u5730\u70b9\uff0c\u6240\u4ee5\u516c\u53f8\u540d\u5e94\u8be5\u662f\u201cRitzi & Wagner\u201d\uff0c\u800c\u5730\u70b9\u662f\u201cSt.Gallen (Amriswil)\u201d\u3002\u4e0d\u8fc7\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5730\u70b9\u90e8\u5206\u53ea\u4fdd\u7559\u57ce\u5e02\u6216\u57ce\u9547\uff0c\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u793a\u4f8b\uff0c\u53ef\u80fd\u76f4\u63a5\u53d6\u62ec\u53f7\u5185\u7684\u90e8\u5206\uff0c\u6216\u8005\u6574\u4e2a\u4f5c\u4e3a\u5730\u70b9\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u4fdd\u6301\u539f\u6837\uff0c\u6240\u4ee5location\u7684transcription\u5e94\u8be5\u662f\u201cSt.Gallen (Amriswil)\u201d\u3002\\n\\n\u63a5\u4e0b\u6765\u662fb_id\uff0c\u4f4d\u4e8e\u53f3\u4e0a\u89d2\uff0c\u4ee5B.\u5f00\u5934\u3002\u56fe\u50cf\u4e2d\u663e\u793a\u7684\u662f\u201cB.51.322.GB.808.\u201d\uff0c\u6240\u4ee5\u76f4\u63a5\u63d0\u53d6\u8fd9\u4e2a\u4f5c\u4e3ab_id\u7684transcription\u3002\\n\\n\u65e5\u671f\u90e8\u5206\u9700\u8981\u67e5\u627e\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u683c\u5f0f\u4e3aYYYY-MM-DD\u3002\u56fe\u50cf\u4e2d\u6709\u4e24\u4e2a\u65e5\u671f\uff1a\u4e00\u4e2a\u662f\u201cAmendment 20, Dezember 1942.\u201d\uff0c\u53e6\u4e00\u4e2a\u662f\u201cgestrichen: Amendment 13, 23.11.1945.\u201d\u3002\u7528\u6237\u8981\u6c42\u7684\u662f\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u4f46\u8fd9\u4e24\u4e2a\u770b\u8d77\u6765\u662f\u6587\u672c\u4e2d\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u4e0d\u662f\u76d6\u7ae0\u7684\u3002\u4e0d\u8fc7\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u8fd9\u4e9b\u65e5\u671f\uff0c\u4f46\u9700\u8981\u8f6c\u6362\u4e3aYYYY-MM-DD\u683c\u5f0f\u3002\u4f8b\u5982\uff0cDezember 1942\u8f6c\u6362\u4e3a1942-12-01\uff0c\u800c23.11.1945\u8f6c\u6362\u4e3a1945-11-23\u3002\u4f46\u7528\u6237\u53ef\u80fd\u53ea\u63a5\u53d7\u660e\u786e\u7684\u65e5\u671f\u683c\u5f0f\uff0c\u6216\u8005\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\u3002\u5982\u679c\u56fe\u50cf\u4e2d\u6ca1\u6709\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u7559\u7a7a\u3002\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u4f8b\u5b50\uff0c\u53ef\u80fd\u8fd9\u4e24\u4e2a\u65e5\u671f\u9700\u8981\u5904\u7406\u3002\u4e0d\u8fc7\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u53ea\u63d0\u53d6\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u800c\u8fd9\u91cc\u53ef\u80fd\u6ca1\u6709\uff0c\u6240\u4ee5date\u5b57\u6bb5\u53ef\u80fd\u7559\u7a7a\u3002\u9700\u8981\u4ed4\u7ec6\u68c0\u67e5\u56fe\u50cf\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u4f46\u6839\u636e\u63cf\u8ff0\uff0c\u53ef\u80fd\u6ca1\u6709\uff0c\u6240\u4ee5date\u8bbe\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u4fe1\u606f\u90e8\u5206\u9700\u8981\u63d0\u53d6\u4e3b\u4f53\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\u4e3b\u4f53\u90e8\u5206\u6709\u4e24\u6bb5\uff1a\u201cBritische schwarze Liste\\\\nAmendment 20, Dezember 1942.\u201d\u548c\u201cgestrichen:\\\\nAmendment 13, 23.11.1945.\u201d\u3002\u9700\u8981\u5c06\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\uff0c\u6240\u4ee5information\u6570\u7ec4\u91cc\u6709\u4e24\u4e2a\u5bf9\u8c61\uff0c\u6bcf\u4e2a\u7684transcription\u5206\u522b\u662f\u8fd9\u4e24\u6bb5\uff0c\u6ce8\u610f\u6362\u884c\u7b26\u7528\\\\n\u8868\u793a\u3002\\n\\n\u73b0\u5728\u9700\u8981\u786e\u8ba4\u6bcf\u4e2a\u90e8\u5206\u662f\u5426\u7b26\u5408\u8981\u6c42\u3002\u516c\u53f8\u540d\u662f\u5426\u6b63\u786e\uff0c\u5730\u70b9\u662f\u5426\u5305\u542b\u62ec\u53f7\u5185\u7684\u90e8\u5206\uff0cb_id\u662f\u5426\u6b63\u786e\uff0c\u65e5\u671f\u662f\u5426\u5b58\u5728\uff0c\u4fe1\u606f\u662f\u5426\u6b63\u786e\u5206\u5757\u3002\u53ef\u80fd\u9700\u8981\u6ce8\u610f\u5fb7\u8bed\u4e2d\u7684\u62fc\u5199\uff0c\u6bd4\u5982\u201cgestrichen\u201d\u662f\u5426\u6b63\u786e\u8f6c\u5f55\uff0c\u4ee5\u53ca\u65e5\u671f\u683c\u5f0f\u662f\u5426\u6b63\u786e\u8f6c\u6362\u3002\u4f8b\u5982\uff0cDezember\u662f12\u6708\uff0c\u6240\u4ee51942-12-01\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u4fdd\u7559\u539f\u59cb\u6587\u672c\u4e2d\u7684\u65e5\u671f\u683c\u5f0f\uff0c\u4f46\u6839\u636e\u7528\u6237\u6307\u793a\uff0cdate\u5b57\u6bb5\u9700\u8981YYYY-MM-DD\u683c\u5f0f\uff0c\u4f46\u5982\u679c\u6ca1\u6709\u660e\u786e\u7684\u76d6\u7ae0\u65e5\u671f\uff0c\u53ef\u80fd\u7559\u7a7a\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u5224\u65ad\uff0c\u5982\u679c\u7528\u6237\u63d0\u4f9b\u7684\u4f8b\u5b50\u4e2d\u65e5\u671f\u662f\u6587\u672c\u4e2d\u7684\uff0c\u662f\u5426\u5e94\u8be5\u63d0\u53d6\u3002\u6839\u636e\u7528\u6237\u8bf4\u660e\uff0cdate\u662f\u201c\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6ca1\u6709\u76d6\u7ae0\uff0c\u5c31\u7559\u7a7a\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fddJSON\u7ed3\u6784\u6b63\u786e\uff0c\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u6709\u5bf9\u5e94\u7684transcription\uff0c\u4fe1\u606f\u90e8\u5206\u6b63\u786e\u5206\u5757\uff0c\u6ca1\u6709\u9057\u6f0f\u3002\\n\",\"format\":\"unknown\",\"index\":0}]},\"native_finish_reason\":\"stop\"}],\"created\":1789650907,\"model\":\"qwen/qwen3.5-397b-a17b\",\"object\":\"chat.completion\",\"service_tier\":null,\"system_fingerprint\":null,\"usage\":{\"completion_tokens\":860,\"prompt_tokens\":2853,\"total_tokens\":3713,\"completion_tokens_details\":{\"accepted_prediction_tokens\":null,\"audio_tokens\":0,\"reasoning_tokens\":709,\"rejected_prediction_tokens\":null,\"image_tokens\":0},\"prompt_tokens_details\":{\"audio_tokens\":0,\"cached_tokens\":0,\"cache_write_tokens\":0,\"video_tokens\":0},\"cost\":0.0048078,\"is_byok\":false,\"cost_details\":{\"upstream_inference_cost\":0.0048078,\"upstream_inference_prompt_cost\":0.0017118,\"upstream_inference_completions_cost\":0.003096}},\"provider\":\"StreamLake\"}"

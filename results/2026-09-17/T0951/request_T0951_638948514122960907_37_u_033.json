c\u5f0f\u662f\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u4f46\u6839\u636e\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u53d6\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u6ca1\u6709\u660e\u786e\u7684\u76d6\u7ae0\u65e5\u671f\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u4f8b\u5982\uff0c\u8fd9\u91cc\u7684\u201c18.6.1945\u201d\u662f\u624b\u5199\u7684\uff0c\u800c\u201cFebruar 1942\u201d\u662f\u6253\u5370\u7684\u3002\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u65e5\u671f\u8f6c\u6362\u4e3aYYYY-MM-DD\u683c\u5f0f\uff0c\u6240\u4ee5\u201c18.6.1945\u201d\u8f6c\u6362\u4e3a\u201c1945-06-18\u201d\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u5e94\u8be5\u5305\u62ec\u8fd9\u4e2a\u65e5\u671f\u3002\u5982\u679c\u7528\u6237\u8981\u6c42\u7684\u662f\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u6ca1\u6709\uff0c\u4f46\u8fd9\u91cc\u53ef\u80fd\u6ca1\u6709\u76d6\u7ae0\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u53ef\u80fddate\u5b57\u6bb5\u7559\u7a7a\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u63a5\u53d7\u624b\u5199\u7684\u65e5\u671f\u3002\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u6307\u793a\u3002\u7528\u6237\u8bf4\u201c\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\u201d\uff0c\u4f46\u56fe\u7247\u4e2d\u7684\u65e5\u671f\u53ef\u80fd\u4e0d\u662f\u76d6\u7ae0\u7684\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u4f8b\u5982\uff0c\u201cAmendment 2, Februar 1942\u201d\u662f\u6253\u5370\u7684\uff0c\u800c\u201c18.6.1945\u201d\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u53ef\u80fd\u6ca1\u6709\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u56e0\u6b64date\u5b57\u6bb5\u7559\u7a7a\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u6240\u6709\u65e5\u671f\uff0c\u4e0d\u7ba1\u662f\u5426\u76d6\u7ae0\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5224\u65ad\u3002\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u4f8b\u5b50\uff0c\u53ef\u80fddate\u5b57\u6bb5\u5e94\u8be5\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5373\u4f7f\u4e0d\u662f\u76d6\u7ae0\u7684\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5b58\u5728\u65e5\u671f\uff0c\u5c31\u8f6c\u6362\u683c\u5f0f\u3002\u6240\u4ee5\u8fd9\u91cc\u201c18.6.1945\u201d\u53ef\u4ee5\u8f6c\u6362\u4e3a\u201c1945-06-18\u201d\uff0c\u800c\u201cFebruar 1942\u201d\u53ef\u80fd\u6ca1\u6709\u5177\u4f53\u65e5\u671f\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u63d0\u53d6\u540e\u8005\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u6240\u6709\u65e5\u671f\uff0c\u4f46\u683c\u5f0f\u8981\u6c42\u662fYYYY-MM-DD\uff0c\u6240\u4ee5\u53ea\u6709\u201c18.6.1945\u201d\u53ef\u4ee5\u8f6c\u6362\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u8be5\u662f\u201c1945-06-18\u201d\u3002\\n\\n\u7136\u540e\u662f\u4fe1\u606f\uff08information\uff09\u90e8\u5206\uff0c\u9700\u8981\u63d0\u53d6\u4e3b\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\u4e3b\u6587\u672c\u5305\u62ec\uff1a\\n\\n- Britische schwarze Liste\\n- Amendment 2, Februar 1942.\\n- gestrichen:\\n- Amendment 7, 18.6.1945.\\n- \u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\u7684\u5185\u5bb9\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\uff0c\u56e0\u4e3a\u7528\u6237\u53ef\u80fd\u53ea\u9700\u8981\u6e05\u6670\u7684\u6587\u672c\u3002\u4f46\u9700\u8981\u770b\u662f\u5426\u5305\u62ec\u3002\u4f8b\u5982\uff0c\u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\u8f6c\u5f55\u3002\u4f46\u7528\u6237\u6307\u793a\u4e2d\u8bf4\u201c\u4e3b\u6587\u672c\u5757\u201d\uff0c\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u786e\u8ba4\u3002\u4f8b\u5982\uff0c\u56fe\u7247\u4e2d\u7684\u624b\u5199\u90e8\u5206\u201cfig noch auf franz. liste Suppl. 6, 31.8.45\u201d\u88ab\u5212\u6389\uff0c\u4f46\u53ef\u80fd\u4ecd\u9700\u8f6c\u5f55\u3002\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u53ea\u8f6c\u5f55\u672a\u88ab\u5212\u6389\u7684\u90e8\u5206\uff1f\u6216\u8005\u5168\u90e8\uff1f\u6839\u636e\u7528\u6237\u793a\u4f8b\uff0c\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u4fdd\u7559\u6362\u884c\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u5757\u53ef\u80fd\u5206\u4e3a\u51e0\u4e2a\u90e8\u5206\uff1a\\n\\n1. Britische schwarze Liste\\n   Amendment 2, Februar 1942.\\n2. gestrichen:\\n   Amendment 7, 18.6.1945.\\n3. \u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\uff0c\u4f46\u53ef\u80fd\u4ecd\u9700\u8f6c\u5f55\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5ffd\u7565\u88ab\u5212\u6389\u7684\u90e8\u5206\uff1f\u6216\u8005\u662f\u5426\u5305\u62ec\uff1f\\n\\n\u6839\u636e\u7528\u6237\u6307\u793a\uff0c\u201c\u4e3b\u6587\u672c\u5757\u201d\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u4fdd\u6301\u6362\u884c\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u53ef\u80fd\u5206\u4e3a\u51e0\u4e2a\u6bb5\u843d\uff1a\\n\\n- \u7b2c\u4e00\u6bb5\uff1a\u201cBritische schwarze Liste\\\\nAmendment 2, Februar 1942.\u201d\\n- \u7b2c\u4e8c\u6bb5\uff1a\u201cgestrichen:\\\\nAmendment 7, 18.6.1945.\u201d\\n- \u7b2c\u4e09\u6bb5\u662f\u624b\u5199\u88ab\u5212\u6389\u7684\u90e8\u5206\uff0c\u53ef\u80fd\u8f6c\u5f55\u4e3a\u201cfig noch auf franz. liste Suppl. 6, 31.8.45\u201d\uff0c\u4f46\u88ab\u5212\u6389\uff0c\u662f\u5426\u5305\u62ec\uff1f\\n\\n\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u8f6c\u5f55\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u5373\u4f7f\u88ab\u5212\u6389\u3002\u6240\u4ee5\u4fe1\u606f\u90e8\u5206\u53ef\u80fd\u5305\u62ec\u4e09\u4e2a\u6761\u76ee\uff1a\\n\\n1. \\\"Britische schwarze Liste\\\\nAmendment 2, Februar 1942.\\\"\\n2. \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"\\n3. \\\"fig noch auf franz. liste Suppl. 6, 31.8.45\\\"\uff08\u4f46\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u9700\u8981\u4fdd\u7559\uff09\\n\\n\u4f46\u9700\u8981\u786e\u8ba4\u3002\u4f8b\u5982\uff0c\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u90e8\u5206\u53ef\u80fd\u5c06\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u53ef\u80fd\u88ab\u5206\u4e3a\u4e09\u4e2a\u90e8\u5206\uff1a\\n\\n- \u7b2c\u4e00\u6bb5\uff1aBritische schwarze Liste...\\n- \u7b2c\u4e8c\u6bb5\uff1agestrichen:...\\n- \u7b2c\u4e09\u6bb5\uff1a\u624b\u5199\u90e8\u5206\u3002\\n\\n\u6240\u4ee5\u4fe1\u606f\u5217\u8868\u5e94\u8be5\u5305\u542b\u8fd9\u4e09\u4e2a\u90e8\u5206\uff0c\u6bcf\u4e2a\u4f5c\u4e3a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\u4f8b\u5982\uff1a\\n\\n[\\n  {\\\"transcription\\\": \\\"Britische schwarze Liste\\\\nAmendment 2, Februar 1942.\\\"},\\n  {\\\"transcription\\\": \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"},\\n  {\\\"transcription\\\": \\\"fig noch auf franz. liste Suppl. 6, 31.8.45\\\"}\\n]\\n\\n\u4f46\u9700\u8981\u68c0\u67e5\u624b\u5199\u90e8\u5206\u662f\u5426\u88ab\u5212\u6389\uff0c\u662f\u5426\u5e94\u8be5\u5305\u62ec\u3002\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u8f6c\u5f55\u6240\u6709\u5185\u5bb9\uff0c\u5305\u62ec\u88ab\u5212\u6389\u7684\uff0c\u6240\u4ee5\u5e94\u8be5\u5305\u62ec\u3002\\n\\n\u73b0\u5728\uff0c\u7efc\u5408\u6240\u6709\u90e8\u5206\uff1a\\n\\ncompany: \\\"Mas, & Co., Michel\\\"\\nlocation: \\\"ZUERICH\\\"\\nb_id: \\\"B.51.322.GB.468.\\\"\\ndate: \\\"1945-06-18\\\"\uff08\u6765\u81ea18.6.1945\uff09\\ninformation: \u4e09\u4e2a\u6761\u76ee\uff0c\u5982\u4e0a\u8ff0\u3002\\n\\n\u4f46\u9700\u8981\u786e\u8ba4date\u662f\u5426\u6b63\u786e\u3002\u7528\u6237\u8981\u6c42\u7684\u662fYYYY-MM-DD\u683c\u5f0f\uff0c\u6240\u4ee518.6.1945\u8f6c\u6362\u4e3a1945-06-18\u3002\u800cFebruar 1942\u6ca1\u6709\u5177\u4f53\u65e5\u671f\uff0c\u6240\u4ee5\u4e0d\u8f6c\u6362\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u4e3a\u201c1945-06-18\u201d\u3002\\n\\n\u73b0\u5728\uff0c\u68c0\u67e5\u6bcf\u4e2a\u5b57\u6bb5\u662f\u5426\u7b26\u5408\u8981\u6c42\uff1a\\n\\n- company\u662f\u5426\u6b63\u786e\uff1f\u539f\u5361\u7247\u5de6\u4e0a\u89d2\u662f\u201cMas, & Co., Michel, ZUERICH\u201d\uff0c\u6240\u4ee5\u516c\u53f8\u540d\u662f\u201cMas, & Co., Michel\u201d\uff0c\u5730\u70b9\u662f\u201cZUERICH\u201d\u3002\\n- b_id\u662f\u5426\u6b63\u786e\uff1f\u53f3\u4e0a\u89d2\u662fB.51.322.GB.468.\uff0c\u6240\u4ee5\u6b63\u786e\u3002\\n- date\u662f\u5426\u6b63\u786e\uff1f\u662f\u7684\uff0c18.6.1945\u8f6c\u6362\u4e3a1945-06-18\u3002\\n- information\u4e2d\u7684\u6bcf\u4e2a\u6761\u76ee\u662f\u5426\u6b63\u786e\uff1f\u662f\u7684\uff0c\u5305\u62ec\u4e09\u4e2a\u90e8\u5206\uff0c\u6bcf\u4e2a\u4f5c\u4e3a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fddJSON\u683c\u5f0f\u6b63\u786e\uff0c\u6ca1\u6709\u591a\u4f59\u5185\u5bb9\uff0c\u7b26\u5408\u63d0\u4f9b\u7684schema\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u5f20\u7d22\u5f15\u5361\u56fe\u7247\uff0c\u5e76\u6309\u7167\u8981\u6c42\u63d0\u53d6\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u9700\u8981\u4ed4\u7ec6\u67e5\u770b\u56fe\u7247\u7684\u5404\u4e2a\u90e8\u5206\uff0c\u786e\u5b9a\u6bcf\u4e2a\u5b57\u6bb5\u7684\u4f4d\u7f6e\u548c\u5185\u5bb9\u3002\\n\\n\u9996\u5148\u770b\u516c\u53f8\uff08company\uff09\u90e8\u5206\uff0c\u901a\u5e38\u5728\u5de6\u4e0a\u89d2\u3002\u56fe\u7247\u5de6\u4e0a\u89d2\u5199\u7740\u201cMas, & Co., Michel, ZUERICH\u201d\u3002\u8fd9\u91cc\u9700\u8981\u6392\u9664\u5730\u70b9\uff0c\u6240\u4ee5\u516c\u53f8\u5e94\u8be5\u662f\u201cMas, & Co., Michel\u201d\uff0c\u800c\u5730\u70b9\u662f\u201cZUERICH\u201d\u3002\u4e0d\u8fc7\u8981\u6ce8\u610f\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u516c\u53f8\u540d\u662f\u5426\u5305\u62ec\u201cMichel\u201d\uff0c\u6216\u8005\u662f\u5426\u5e94\u8be5\u5206\u5f00\u3002\u4f46\u6839\u636e\u4f8b\u5b50\uff0c\u53ef\u80fd\u516c\u53f8\u540d\u662f\u201cMas, & Co., Michel\u201d\uff0c\u800c\u5730\u70b9\u662f\u201cZUERICH\u201d\u3002\\n\\n\u63a5\u4e0b\u6765\u662f\u4f4d\u7f6e\uff08location\uff09\uff0c\u901a\u5e38\u5728\u516c\u53f8\u540d\u4e4b\u540e\uff0c\u6240\u4ee5\u8fd9\u91cc\u5e94\u8be5\u662f\u201cZUERICH\u201d\u3002\\n\\n\u7136\u540e\u662fb_id\uff0c\u4f4d\u4e8e\u53f3\u4e0a\u89d2\uff0c\u683c\u5f0f\u662fB.\u5f00\u5934\u3002\u56fe\u7247\u53f3\u4e0a\u89d2\u663e\u793a\u7684\u662f\u201cB.51.322.GB.468.\u201d\uff0c\u6240\u4ee5\u76f4\u63a5\u63d0\u53d6\u8fd9\u4e2a\u5b57\u7b26\u4e32\u3002\\n\\n\u65e5\u671f\uff08date\uff09\u90e8\u5206\uff0c\u9700\u8981\u67e5\u627e\u662f\u5426\u6709\u76d6\u7ae0\u7684\u65e5\u671f\u3002\u56fe\u7247\u4e2d\u6709\u4e24\u4e2a\u65e5\u671f\uff1a\u4e00\u4e2a\u662f\u201cAmendment 2, Februar 1942\u201d\uff0c\u53e6\u4e00\u4e2a\u662f\u201cgestrichen: Amendment 7, 18.6.1945\u201d\u3002\u4e0d\u8fc7\u7528\u6237\u8981\u6c42\u7684\u662fYYYY-MM-DD\u683c\u5f0f\u3002\u8fd9\u91cc\u201c18.6.1945\u201d\u53ef\u4ee5\u8f6c\u6362\u4e3a\u201c1945-06-18\u201d\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u5e94\u8be5\u63d0\u53d6\u8fd9\u4e2a\u65e5\u671f\u3002\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u6240\u6709\u65e5\u671f\uff0c\u4f46\u6839\u636e\u6307\u793a\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u4e00\u4e2a\u65e5\u671f\u3002\u6216\u8005\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u5217\u51fa\u6765\uff1f\u4e0d\u8fc7\u7528\u6237\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u4e00\u4e2a\u3002\u4f46\u539f\u95ee\u9898\u4e2d\u7684date\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u53ea\u53d6\u4e00\u4e2a\u3002\u9700\u8981\u770b\u7528\u6237\u7684\u5177\u4f53\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201c\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u683c\u5f0f\u662f\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u9700\u8981\u5408\u5e76\u3002\u4f46\u6839\u636e\u793a\u4f8b\uff0c\u53ef\u80fd\u53ea\u53d6\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u6ca1\u6709\u660e\u786e\u7684\u76d6\u7ae0\u65e5\u671f\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u4f8b\u5982\uff0c\u8fd9\u91cc\u7684\u201c18.6.1945\u201d\u662f\u624b\u5199\u7684\uff0c\u800c\u201cFebruar 1942\u201d\u662f\u6253\u5370\u7684\u3002\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u65e5\u671f\u8f6c\u6362\u4e3aYYYY-MM-DD\u683c\u5f0f\uff0c\u6240\u4ee5\u201c18.6.1945\u201d\u8f6c\u6362\u4e3a\u201c1945-06-18\u201d\u3002\u4f46\u9700\u8981\u786e\u8ba4\u662f\u5426\u5e94\u8be5\u5305\u62ec\u8fd9\u4e2a\u65e5\u671f\u3002\u5982\u679c\u7528\u6237\u8981\u6c42\u7684\u662f\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u6ca1\u6709\uff0c\u4f46\u8fd9\u91cc\u53ef\u80fd\u6ca1\u6709\u76d6\u7ae0\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u53ef\u80fddate\u5b57\u6bb5\u7559\u7a7a\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u63a5\u53d7\u624b\u5199\u7684\u65e5\u671f\u3002\u9700\u8981\u4ed4\u7ec6\u770b\u7528\u6237\u6307\u793a\u3002\u7528\u6237\u8bf4\u201c\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\u201d\uff0c\u4f46\u56fe\u7247\u4e2d\u7684\u65e5\u671f\u53ef\u80fd\u4e0d\u662f\u76d6\u7ae0\u7684\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u4f8b\u5982\uff0c\u201cAmendment 2, Februar 1942\u201d\u662f\u6253\u5370\u7684\uff0c\u800c\u201c18.6.1945\u201d\u662f\u624b\u5199\u7684\u3002\u6240\u4ee5\u53ef\u80fd\u6ca1\u6709\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u56e0\u6b64date\u5b57\u6bb5\u7559\u7a7a\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u6240\u6709\u65e5\u671f\uff0c\u4e0d\u7ba1\u662f\u5426\u76d6\u7ae0\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5224\u65ad\u3002\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u4f8b\u5b50\uff0c\u53ef\u80fddate\u5b57\u6bb5\u5e94\u8be5\u63d0\u53d6\u5b58\u5728\u7684\u65e5\u671f\uff0c\u5373\u4f7f\u4e0d\u662f\u76d6\u7ae0\u7684\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5b58\u5728\u65e5\u671f\uff0c\u5c31\u8f6c\u6362\u683c\u5f0f\u3002\u6240\u4ee5\u8fd9\u91cc\u201c18.6.1945\u201d\u53ef\u4ee5\u8f6c\u6362\u4e3a\u201c1945-06-18\u201d\uff0c\u800c\u201cFebruar 1942\u201d\u53ef\u80fd\u6ca1\u6709\u5177\u4f53\u65e5\u671f\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u63d0\u53d6\u540e\u8005\uff1f\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u63d0\u53d6\u6240\u6709\u65e5\u671f\uff0c\u4f46\u683c\u5f0f\u8981\u6c42\u662fYYYY-MM-DD\uff0c\u6240\u4ee5\u53ea\u6709\u201c18.6.1945\u201d\u53ef\u4ee5\u8f6c\u6362\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u8be5\u662f\u201c1945-06-18\u201d\u3002\\n\\n\u7136\u540e\u662f\u4fe1\u606f\uff08information\uff09\u90e8\u5206\uff0c\u9700\u8981\u63d0\u53d6\u4e3b\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\u4e3b\u6587\u672c\u5305\u62ec\uff1a\\n\\n- Britische schwarze Liste\\n- Amendment 2, Februar 1942.\\n- gestrichen:\\n- Amendment 7, 18.6.1945.\\n- \u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\u7684\u5185\u5bb9\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\uff0c\u56e0\u4e3a\u7528\u6237\u53ef\u80fd\u53ea\u9700\u8981\u6e05\u6670\u7684\u6587\u672c\u3002\u4f46\u9700\u8981\u770b\u662f\u5426\u5305\u62ec\u3002\u4f8b\u5982\uff0c\u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\u8f6c\u5f55\u3002\u4f46\u7528\u6237\u6307\u793a\u4e2d\u8bf4\u201c\u4e3b\u6587\u672c\u5757\u201d\uff0c\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u786e\u8ba4\u3002\u4f8b\u5982\uff0c\u56fe\u7247\u4e2d\u7684\u624b\u5199\u90e8\u5206\u201cfig noch auf franz. liste Suppl. 6, 31.8.45\u201d\u88ab\u5212\u6389\uff0c\u4f46\u53ef\u80fd\u4ecd\u9700\u8f6c\u5f55\u3002\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u53ea\u8f6c\u5f55\u672a\u88ab\u5212\u6389\u7684\u90e8\u5206\uff1f\u6216\u8005\u5168\u90e8\uff1f\u6839\u636e\u7528\u6237\u793a\u4f8b\uff0c\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u4fdd\u7559\u6362\u884c\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u5757\u53ef\u80fd\u5206\u4e3a\u51e0\u4e2a\u90e8\u5206\uff1a\\n\\n1. Britische schwarze Liste\\n   Amendment 2, Februar 1942.\\n2. gestrichen:\\n   Amendment 7, 18.6.1945.\\n3. \u624b\u5199\u90e8\u5206\u88ab\u5212\u6389\uff0c\u4f46\u53ef\u80fd\u4ecd\u9700\u8f6c\u5f55\uff0c\u4f46\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5ffd\u7565\u88ab\u5212\u6389\u7684\u90e8\u5206\uff1f\u6216\u8005\u662f\u5426\u5305\u62ec\uff1f\\n\\n\u6839\u636e\u7528\u6237\u6307\u793a\uff0c\u201c\u4e3b\u6587\u672c\u5757\u201d\u53ef\u80fd\u5305\u62ec\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u4f46\u9700\u8981\u4fdd\u6301\u6362\u884c\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u53ef\u80fd\u5206\u4e3a\u51e0\u4e2a\u6bb5\u843d\uff1a\\n\\n- \u7b2c\u4e00\u6bb5\uff1a\u201cBritische schwarze Liste\\\\nAmendment 2, Februar 1942.\u201d\\n- \u7b2c\u4e8c\u6bb5\uff1a\u201cgestrichen:\\\\nAmendment 7, 18.6.1945.\u201d\\n- \u7b2c\u4e09\u6bb5\u662f\u624b\u5199\u88ab\u5212\u6389\u7684\u90e8\u5206\uff0c\u53ef\u80fd\u8f6c\u5f55\u4e3a\u201cfig noch auf franz. liste Suppl. 6, 31.8.45\u201d\uff0c\u4f46\u88ab\u5212\u6389\uff0c\u662f\u5426\u5305\u62ec\uff1f\\n\\n\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u8f6c\u5f55\u6240\u6709\u6587\u672c\uff0c\u5305\u62ec\u624b\u5199\u7684\uff0c\u5373\u4f7f\u88ab\u5212\u6389\u3002\u6240\u4ee5\u4fe1\u606f\u90e8\u5206\u53ef\u80fd\u5305\u62ec\u4e09\u4e2a\u6761\u76ee\uff1a\\n\\n1. \\\"Britische schwarze Liste\\\\nAmendment 2, Februar 1942.\\\"\\n2. \\\"gestrichen:\\\\nAmendment 7, 18.6.1945.\\\"\\n3. \\\"fig noch auf franz. liste Suppl. 6, 31.8.45\\\"\uff08\u4f46\u88ab\u5212\u6389\uff0c\u53ef\u80fd\u9700\u8981\u4fdd\u7559\uff09\\n\\n\u4f46\u9700\u8981\u786e\u8ba4\u3002\u4f8b\u5982\uff0c\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u90e8\u5206\u53ef\u80fd\u5c06\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e2d\u7684\u6587\u672c\u53ef\u80fd\u88ab\u5206\u4e3a\u4e09\u4e2a\u90e8\u5206\uff1a\\n\\n- \u7b2c\u4e00\u6bb5\uff1aBritische schwarze Liste...\\n- \u7b2c\u4e8c\u6bb5\uff1agestrichen:...\\n- \u7b2c\u4e09\u6bb5\uff1a\u624b\u5
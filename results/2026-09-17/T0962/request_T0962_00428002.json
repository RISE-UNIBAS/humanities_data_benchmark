6237\u63d0\u4f9b\u7684Schema\uff0c\u5fc5\u987b\u4e25\u683c\u6309\u7167Schema\u6765\u751f\u6210JSON\uff0c\u6240\u4ee5year\u5e94\u8be5\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u5e0c\u671b\u662f\u6574\u6570\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u5e0c\u671b\u662f\u6574\u6570\u3002\u8fd9\u53ef\u80fd\u5bfc\u81f4\u9519\u8bef\uff0c\u4f46\u5fc5\u987b\u6309\u7167Schema\u6765\u3002\\n\\n\u4e0d\u8fc7\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0c\u53ef\u80fdyear\u662f\u6574\u6570\uff0c\u4f46\u6839\u636eSchema\uff0c\u662f\u5b57\u7b26\u4e32\u3002\u4f8b\u5982\uff0c\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u5373\u4f7f\u89c4\u5219\u4e2d\u8bf4\u6574\u6570\uff0c\u4e5f\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\u3002\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u8bf4year\u662f\u6574\u6570\uff0c\u8fd9\u53ef\u80fd\u662f\u4e2a\u77db\u76fe\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u4ee5Schema\u4e3a\u51c6\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u8fd4\u56de\u7684JSON\u5fc5\u987b\u7b26\u5408\u63d0\u4f9b\u7684Schema\u3002\u56e0\u6b64\uff0cyear\u5e94\u8be5\u4f5c\u4e3a\u5b57\u7b26\u4e32\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u5e0c\u671b\u662f\u6574\u6570\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5fc5\u987b\u7528\u5b57\u7b26\u4e32\u3002\\n\\n\u4e0d\u8fc7\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0c\u53ef\u80fdyear\u662f\u6574\u6570\uff0c\u4f46\u6839\u636eSchema\uff0c\u662f\u5b57\u7b26\u4e32\u3002\u4f8b\u5982\uff0c\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u5373\u4f7f\u89c4\u5219\u4e2d\u8bf4\u6574\u6570\uff0c\u4e5f\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\u3002\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u8bf4year\u662f\u6574\u6570\uff0c\u8fd9\u53ef\u80fd\u662f\u4e2a\u77db\u76fe\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u4ee5Schema\u4e3a\u51c6\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u8fd4\u56de\u7684JSON\u5fc5\u987b\u7b26\u5408\u63d0\u4f9b\u7684Schema\u3002\u56e0\u6b64\uff0cyear\u5e94\u8be5\u4f5c\u4e3a\u5b57\u7b26\u4e32\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u5e0c\u671b\u662f\u6574\u6570\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5fc5\u987b\u7528\u5b57\u7b26\u4e32\u3002\\n\\n\u4e0d\u8fc7\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0c\u53ef\u80fdyear\u662f\u6574\u6570\uff0c\u4f46\u6839\u636eSchema\uff0c\u662f\u5b57\u7b26\u4e32\u3002\u4f8b\u5982\uff0c\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u5373\u4f7f\u89c4\u5219\u4e2d\u8bf4\u6574\u6570\uff0c\u4e5f\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\u3002\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u8bf4year\u662f\u6574\u6570\uff0c\u8fd9\u53ef\u80fd\u662f\u4e2a\u77db\u76fe\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u4ee5Schema\u4e3a\u51c6\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u8fd4\u56de\u7684JSON\u5fc5\u987b\u7b26\u5408\u63d0\u4f9b\u7684Schema\u3002\u56e0\u6b64\uff0cyear\u5e94\u8be5\u4f5c\u4e3a\u5b57\u7b26\u4e32\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u5e0c\u671b\u662f\u6574\u6570\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5fc5\u987b\u7528\u5b57\u7b26\u4e32\u3002\\n\\n\u73b0\u5728\u56de\u5230\u5f53\u524d\u95ee\u9898\uff0c\u5361\u7247\u4e2d\u6ca1\u6709\u5e74\u4efd\u4fe1\u606f\uff0c\u6240\u4ee5year\u5b57\u6bb5\u5e94\u8be5\u7559\u7a7a\u5b57\u7b26\u4e32\u3002\u4f46\u6839\u636e\u89c4\u52193\uff0c\u5982\u679c\u5e74\u4efd\u4e0d\u5b58\u5728\uff0c\u5e94\u8be5\u7701\u7565\u8be5\u5b57\u6bb5\u3002\u4f46\u6839\u636eSchema\uff0cyear\u662f\u5fc5\u586b\u5b57\u6bb5\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\uff0c\u4f46\u53ef\u4ee5\u662f\u7a7a\u5b57\u7b26\u4e32\u3002\u56e0\u6b64\uff0c\u5728JSON\u4e2d\uff0cyear\u5e94\u8be5\u662f\u4e00\u4e2a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u63a5\u4e0b\u6765\uff0c\u68c0\u67e5\u5176\u4ed6\u5b57\u6bb5\u3002\u4f8b\u5982\uff0cpublication\u7684title\u662f\u5426\u6b63\u786e\uff0c\u662f\u5426\u5e94\u8be5\u5305\u62ec\u7701\u7565\u53f7\u3002\u6839\u636e\u89c4\u5219\uff0c\u5e94\u8be5\u539f\u6837\u63d0\u53d6\uff0c\u6240\u4ee5\u4fdd\u7559\u201cDisputatio theologica de collegiali dicendi libertate...\u201d\u3002\\n\\n\u7136\u540e\uff0clibrary_reference\u7684shelfmark\u548csubjects\u90fd\u6ca1\u6709\u4fe1\u606f\uff0c\u6240\u4ee5\u7559\u7a7a\u3002\\n\\n\u73b0\u5728\uff0c\u7efc\u5408\u6240\u6709\u4fe1\u606f\uff0c\u751f\u6210\u7684JSON\u5e94\u8be5\u662f\uff1a\\n\\n{\\n  \\\"type\\\": {\\n    \\\"type\\\": \\\"Reference\\\"\\n  },\\n  \\\"author\\\": {\\n    \\\"last_name\\\": \\\"Nagel\\\",\\n    \\\"first_name\\\": \\\"Martin\\\"\\n  },\\n  \\\"publication\\\": {\\n    \\\"title\\\": \\\"Disputatio theologica de collegiali dicendi libertate...\\\",\\n    \\\"year\\\": \\\"\\\",\\n    \\\"place\\\": \\\"\\\",\\n    \\\"pages\\\": \\\"\\\",\\n    \\\"publisher\\\": \\\"\\\",\\n    \\\"format\\\": \\\"\\\",\\n    \\\"editor\\\": \\\"\\\"\\n  },\\n  \\\"library_reference\\\": {\\n    \\\"shelfmark\\\": \\\"\\\",\\n    \\\"subjects\\\": \\\"\\\"\\n  }\\n}\\n\\n\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u7b26\u5408Schema\u3002\u4f8b\u5982\uff0cpublication\u4e2d\u7684editor\u662f\u53ef\u9009\u7684\uff0c\u4f46\u6839\u636eSchema\uff0ceditor\u662f\u5fc5\u586b\u5b57\u6bb5\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\uff0c\u4f46\u53ef\u4ee5\u662f\u7a7a\u5b57\u7b26\u4e32\u3002\u56e0\u6b64\uff0c\u5728JSON\u4e2d\u9700\u8981\u5305\u542beditor\u5b57\u6bb5\uff0c\u503c\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u53e6\u5916\uff0c\u68c0\u67e5author\u90e8\u5206\u662f\u5426\u6b63\u786e\u3002\u6839\u636e\u89c4\u5219\uff0c\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\uff0c\u653e\u5728last_name\uff0cfirst_name\u7559\u7a7a\u3002\u4f46\u8fd9\u91cc\u6709\u4e24\u4e2a\u540d\u5b57\uff0cNagel, Martin\uff0c\u6240\u4ee5last_name\u662fNagel\uff0cfirst_name\u662fMartin\u3002\u6b63\u786e\u3002\\n\\n\u53e6\u5916\uff0ctype\u7684type\u5b57\u6bb5\u662f\u5426\u6b63\u786e\uff0c\u56e0\u4e3a\u5361\u7247\u4e0a\u6709\u201cs.\u201d\uff0c\u6240\u4ee5\u662fReference\u3002\u6b63\u786e\u3002\\n\\n\u73b0\u5728\uff0c\u786e\u8ba4\u6240\u6709\u5fc5\u586b\u5b57\u6bb5\u90fd\u5b58\u5728\uff0c\u6ca1\u6709\u9057\u6f0f\u3002\u4f8b\u5982\uff0cpublication\u4e2d\u7684editor\u5fc5\u987b\u5b58\u5728\uff0c\u5373\u4f7f\u4e3a\u7a7a\u3002library_reference\u7684shelfmark\u548csubjects\u4e5f\u5fc5\u987b\u5b58\u5728\uff0c\u5373\u4f7f\u4e3a\u7a7a\u3002\\n\\n\u56e0\u6b64\uff0c\u6700\u7ec8\u7684JSON\u5e94\u8be5\u7b26\u5408\u8fd9\u4e9b\u8981\u6c42\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u4e2a\u7d22\u5f15\u5361\uff0c\u5e76\u63d0\u53d6\u51fa\u7ed3\u6784\u5316\u7684JSON\u6570\u636e\u3002\u9996\u5148\uff0c\u6211\u5f97\u4ed4\u7ec6\u770b\u770b\u7528\u6237\u7ed9\u7684\u6307\u4ee4\u548c\u793a\u4f8b\uff0c\u786e\u4fdd\u81ea\u5df1\u7406\u89e3\u6b63\u786e\u3002\\n\\n\u9996\u5148\uff0c\u7528\u6237\u8981\u6c42\u6839\u636e\u7d22\u5f15\u5361\u7684\u4fe1\u606f\u751f\u6210\u4e00\u4e2a\u7b26\u5408\u7279\u5b9aJSON Schema\u7684\u54cd\u5e94\u3002\u8fd9\u4e2aSchema\u5305\u62ec\u56db\u4e2a\u4e3b\u8981\u90e8\u5206\uff1atype\u3001author\u3001publication\u548clibrary_reference\u3002\u6bcf\u4e2a\u90e8\u5206\u90fd\u6709\u5177\u4f53\u7684\u5b57\u6bb5\u8981\u6c42\uff0c\u6bd4\u5982type\u53ea\u80fd\u662f\u201cDissertation or thesis\u201d\u6216\u201cReference\u201d\uff0c\u800cauthor\u9700\u8981last_name\u548cfirst_name\uff0c\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\u7684\u8bdd\uff0c\u5c31\u653e\u5728last_name\u91cc\uff0cfirst_name\u7559\u7a7a\u3002\\n\\n\u63a5\u4e0b\u6765\uff0c\u6211\u9700\u8981\u5206\u6790\u7528\u6237\u63d0\u4f9b\u7684\u7d22\u5f15\u5361\u5185\u5bb9\u3002\u56fe\u7247\u4e2d\u7684\u6587\u5b57\u662f\uff1a\\n\\nN a g e l, Martin\\ns.\\nS c h o m e r u s, Justus Christoph. Disputatio theologica de collegiali dicendi libertate...\\n\\n\u9996\u5148\uff0c\u6839\u636e\u89c4\u52191\uff0c\u5982\u679c\u5361\u7247\u4e0a\u6709\u5355\u72ec\u7684\u201cs.\u201d\uff0c\u5219type\u662f\u201cReference\u201d\uff0c\u5426\u5219\u662f\u201cDissertation or thesis\u201d\u3002\u8fd9\u91cc\u786e\u5b9e\u6709\u4e00\u4e2a\u5355\u72ec\u7684\u201cs.\u201d\uff0c\u6240\u4ee5type\u5e94\u8be5\u662f\u201cReference\u201d\u3002\\n\\n\u7136\u540e\u5904\u7406author\u90e8\u5206\u3002\u8fd9\u91cc\u6709\u4e24\u4e2a\u540d\u5b57\uff1aNagel, Martin\u548cSchomerus, Justus Christoph\u3002\u4f46\u6839\u636e\u89c4\u5219\uff0cauthor\u5e94\u8be5\u662f\u6307\u4e3b\u8981\u4f5c\u8005\uff0c\u4e5f\u5c31\u662f\u7b2c\u4e00\u4e2a\u540d\u5b57\u3002\u6240\u4ee5author\u7684last_name\u662fNagel\uff0cfirst_name\u662fMartin\u3002\u4e0d\u8fc7\uff0c\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u6ce8\u610f\uff0c\u56e0\u4e3a\u6709\u65f6\u5019\u7d22\u5f15\u5361\u53ef\u80fd\u5217\u51fa\u7684\u662f\u4f5c\u8005\u548c\u7f16\u8005\uff0c\u4f46\u6839\u636e\u89c4\u5219\uff0c\u53ea\u9700\u8981\u63d0\u53d6\u4f5c\u8005\u7684\u4fe1\u606f\u3002\u6240\u4ee5\u8fd9\u91cc\u5e94\u8be5\u53d6\u7b2c\u4e00\u4e2a\u540d\u5b57\u4f5c\u4e3aauthor\u3002\\n\\n\u63a5\u4e0b\u6765\u662fpublication\u90e8\u5206\u3002\u6807\u9898\u5e94\u8be5\u662f\u201cDisputatio theologica de collegiali dicendi libertate...\u201d\uff0c\u4f46\u53ef\u80fd\u9700\u8981\u53bb\u6389\u7701\u7565\u53f7\u3002\u5e74\u4efd\u6ca1\u6709\u660e\u786e\u7ed9\u51fa\uff0c\u6240\u4ee5year\u5b57\u6bb5\u5e94\u8be5\u7559\u7a7a\u3002place\u3001pages\u3001publisher\u3001format\u8fd9\u4e9b\u4fe1\u606f\u5728\u5361\u7247\u4e0a\u90fd\u6ca1\u6709\u51fa\u73b0\uff0c\u6240\u4ee5\u90fd\u7559\u7a7a\u3002\\n\\n\u7136\u540e\u662flibrary_reference\u90e8\u5206\u3002shelfmark\u901a\u5e38\u4ee5\u201cDiss.\u201d\u6216\u201cAT\u201d\u5f00\u5934\uff0c\u4f46\u8fd9\u91cc\u6ca1\u6709\u63d0\u5230\uff0c\u6240\u4ee5\u7559\u7a7a\u3002subjects\u4e5f\u6ca1\u6709\u660e\u786e\u7684\u4fe1\u606f\uff0c\u6240\u4ee5\u4e5f\u7559\u7a7a\u3002\\n\\n\u4e0d\u8fc7\uff0c\u8fd9\u91cc\u53ef\u80fd\u5b58\u5728\u4e00\u4e2a\u95ee\u9898\uff1a\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u4e2d\uff0cauthor\u90e8\u5206\u53ef\u80fd\u6307\u7684\u662fSchomerus\uff0c\u56e0\u4e3aNagel\u53ef\u80fd\u662f\u7f16\u8005\u6216\u5176\u4ed6\u89d2\u8272\u3002\u4f46\u6839\u636e\u89c4\u5219\uff0cauthor\u5e94\u8be5\u662f\u6307\u4e3b\u8981\u4f5c\u8005\uff0c\u800c\u5361\u7247\u4e0a\u7b2c\u4e00\u4e2a\u540d\u5b57\u662fNagel\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u786e\u8ba4\u3002\u4f46\u6839\u636e\u5e38\u89c1\u7684\u7d22\u5f15\u5361\u7ed3\u6784\uff0c\u53ef\u80fdNagel\u662f\u4f5c\u8005\uff0c\u800cSchomerus\u662f\u53e6\u4e00\u4e2a\u76f8\u5173\u4eba\u7269\uff0c\u6bd4\u5982\u88ab\u5f15\u7528\u7684\u4eba\u3002\u4f46\u6839\u636e\u89c4\u5219\uff0cauthor\u5e94\u8be5\u63d0\u53d6\u7b2c\u4e00\u4e2a\u540d\u5b57\uff0c\u6240\u4ee5\u8fd9\u91cc\u53ef\u80fd\u6b63\u786e\u3002\\n\\n\u53e6\u5916\uff0c\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u4fe1\u606f\u88ab\u5ffd\u7565\u3002\u4f8b\u5982\uff0c\u5361\u7247\u4e0a\u7684\u201cs.\u201d\u53ef\u80fd\u8868\u793a\u8fd9\u662f\u53c2\u8003\u6761\u76ee\uff0c\u6240\u4ee5type\u6b63\u786e\u3002\u5176\u4ed6\u5b57\u6bb5\u5982publication\u7684\u6807\u9898\u662f\u5426\u6b63\u786e\uff0c\u662f\u5426\u6709\u9057\u6f0f\u7684\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u6807\u9898\u4e2d\u7684\u201cDisputatio theologica...\u201d\u662f\u5426\u5b8c\u6574\uff0c\u53ef\u80fd\u9700\u8981\u4fdd\u7559\u539f\u6837\uff0c\u4f46\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u6807\u9898\u53ef\u80fd\u6ca1\u6709\u7701\u7565\u53f7\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5904\u7406\u6389\u3002\u4f46\u6839\u636e\u89c4\u5219\uff0c\u5e94\u8be5\u539f\u6837\u63d0\u53d6\uff0c\u6240\u4ee5\u4fdd\u7559\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fdd\u6240\u6709\u5fc5\u586b\u5b57\u6bb5\u90fd\u5b58\u5728\uff0c\u6ca1\u6709\u9057\u6f0f\u3002\u4f8b\u5982\uff0cpublication\u4e2d\u7684year\u662f\u6574\u6570\uff0c\u4f46\u8fd9\u91cc\u6ca1\u6709\u5e74\u4efd\uff0c\u6240\u4ee5\u5e94\u8be5\u7559\u7a7a\uff0c\u4f46\u6839\u636eSchema\uff0cyear\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u53ef\u80fd\u5141\u8bb8\u7a7a\u5b57\u7b26\u4e32\u3002\u4e0d\u8fc7\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u4f46\u793a\u4f8b\u4e2d\u53ef\u80fd\u671f\u671b\u6574\u6570\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0cyear\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u7559\u7a7a\u5b57\u7b26\u4e32\u3002\u4f46\u7528\u6237\u7ed9\u7684\u793a\u4f8b\u4e2d\uff0cyear\u662f\u6574\u6570\uff0c\u4f46\u6839\u636eSchema\uff0c\u53ef\u80fd\u5141\u8bb8\u7a7a\u5b57\u7b26\u4e32\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u68c0\u67e5Schema\u3002\\n\\n\u67e5\u770b\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u4f46\u793a\u4f8b\u4e2d\u53ef\u80fd\u671f\u671b\u6574\u6570\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0cyear\u7684\u7c7b\u578b\u662f\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u8bf4\u201cyear: Publication year as integer\u201d\uff0c\u8fd9\u91cc\u53ef\u80fd\u5b58\u5728\u77db\u76fe\u3002\u9700\u8981\u786e\u8ba4\u3002\u6839\u636e\u7528\u6237\u6307\u4ee4\u4e2d\u7684EXTRACTION RULES\u7b2c3\u70b9\uff0cyear\u662f\u6574\u6570\uff0c\u4f46Schema\u4e2d\u5b9a\u4e49\u4e3a\u5b57\u7b26\u4e32\u3002\u8fd9\u53ef\u80fd\u662f\u4e2a\u9519\u8bef\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5e94\u8be5\u6309\u7167Schema\u6765\uff0c\u5373year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u8bf4\u6574\u6570\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u4ee5Schema\u4e3a\u51c6\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u66f4\u51c6\u786e\u3002\u4f8b\u5982\uff0c\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u8bf4year\u662f\u6574\u6570\uff0c\u4f46Schema\u4e2d\u662f\u5b57\u7b26\u4e32\u3002\u8fd9\u53ef\u80fd\u662f\u4e2a\u77db\u76fe\uff0c\u9700\u8981\u5904\u7406\u3002\\n\\n\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u5373\u4f7f\u89c4\u5219\u4e2d\u8bf4\u6574\u6570\uff0c\u4e5f\u5e94\u8be5\u6309\u7167Schema\u6765\u3002\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u53ef\u80fd\u66f4\u51c6\u786e\uff0c\u53ef\u80fdSchema\u6709\u8bef\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5e94\u8be5\u9075\u5faaSchema\u7684\u7ed3\u6784\u3002\u4f8b\u5982\uff0c\u5728\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5b57\u7b26\u4e32\u7c7b\u578b\uff0c\u6240\u4ee5\u5373\u4f7f\u89c4\u5219\u4e2d\u8bf4\u6574\u6570\uff0c\u4e5f\u5e94\u8be5\u7528\u5b57\u7b26\u4e32\u3002\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u660e\u786e\u8bf4year\u662f\u6574\u6570\uff0c\u8fd9\u53ef\u80fd\u662f\u4e2a\u77db\u76fe\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u4ee5\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u5219\u4e3a\u51c6\uff0c\u56e0\u4e3aSchema\u53ef\u80fd\u6709\u8bef\u3002\u4f8b\u5982\uff0c\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52193\u8bf4year\u662f\u6574\u6570\uff0c\u800cSchema\u4e2d\u662f\u5b57\u7b26\u4e32\uff0c\u8fd9\u53ef\u80fd\u662f\u4e2a\u9519\u8bef\u3002\u4f46\u6839
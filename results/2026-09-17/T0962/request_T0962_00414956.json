\u5982\u679c\u8fd9\u662f\u53c2\u8003\u53e6\u4e00\u4e2a\u4f5c\u8005\u7684\u4f5c\u54c1\uff0c\u53ef\u80fdsubjects\u662f\u76f8\u5173\u7684\u4e3b\u9898\uff0c\u4f46\u8fd9\u91cc\u53ef\u80fd\u6ca1\u6709\u660e\u786e\u7684\u4e3b\u9898\u8bcd\uff0c\u6240\u4ee5\u53ef\u80fd\u7559\u7a7a\u3002\u6216\u8005\uff0c\u53ef\u80fd\u201cSonnenbichler\u201d\u662f\u4e00\u4e2a\u4e3b\u9898\uff0c\u6240\u4ee5subjects\u586b\u5199\u201cSonnenbichler\u201d\u3002\\n\\n\u4f46\u6839\u636e\u5e38\u89c1\u7684\u56fe\u4e66\u9986\u5361\u7247\uff0c\u4ea4\u53c9\u5f15\u7528\u53ef\u80fd\u7528\u201cs.\u201d\u8868\u793a\u53c2\u89c1\uff0c\u6240\u4ee5\u7b2c\u4e09\u884c\u53ef\u80fd\u662f\u6307\u53c2\u89c1Sonnenbichler\u7684\u6761\u76ee\uff0c\u56e0\u6b64subjects\u53ef\u80fd\u4e0d\u76f8\u5173\uff0c\u800cshelfmark\u53ef\u80fd\u4e0d\u5b58\u5728\u3002\u56e0\u6b64\uff0clibrary_reference\u4e2d\u7684shelfmark\u548csubjects\u90fd\u7559\u7a7a\u3002\\n\\n\u4f46\u9700\u8981\u786e\u8ba4\u3002\u4f8b\u5982\uff0c\u5982\u679c\u5361\u7247\u662f\u53c2\u8003\u7c7b\u578b\uff0c\u53ef\u80fdshelfmark\u53ef\u80fd\u4e0d\u5b58\u5728\uff0c\u800csubjects\u53ef\u80fd\u6839\u636e\u5185\u5bb9\u586b\u5199\u3002\u4f46\u8fd9\u91cc\u6ca1\u6709\u660e\u786e\u7684\u4fe1\u606f\uff0c\u6240\u4ee5\u53ef\u80fd\u90fd\u7559\u7a7a\u3002\\n\\n\u7efc\u4e0a\uff0c\u6700\u7ec8\u7684JSON\u5e94\u8be5\u662f\uff1a\\n\\n{\\n  \\\"type\\\": {\\\"type\\\": \\\"Reference\\\"},\\n  \\\"author\\\": {\\\"last_name\\\": \\\"Montaghemi\\\", \\\"first_name\\\": \\\"Nourhomadeh\\\"},\\n  \\\"publication\\\": {\\n    \\\"title\\\": \\\"\\\",\\n    \\\"year\\\": \\\"\\\",\\n    \\\"place\\\": \\\"\\\",\\n    \\\"pages\\\": \\\"\\\",\\n    \\\"publisher\\\": \\\"\\\",\\n    \\\"format\\\": \\\"\\\",\\n    \\\"editor\\\": \\\"\\\"\\n  },\\n  \\\"library_reference\\\": {\\n    \\\"shelfmark\\\": \\\"\\\",\\n    \\\"subjects\\\": \\\"\\\"\\n  }\\n}\\n\\n\u4f46\u9700\u8981\u68c0\u67e5schema\u4e2d\u7684required\u5b57\u6bb5\u3002\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684schema\uff0cpublication\u4e2d\u7684editor\u662frequired\uff0c\u4f46\u539f\u95ee\u9898\u4e2d\u7684\u793a\u4f8b\u53ef\u80fd\u6ca1\u6709\u63d0\u5230editor\u3002\u67e5\u770b\u7528\u6237\u63d0\u4f9b\u7684schema\uff1a\\n\\n\u5728Publication\u7684properties\u4e2d\uff0ceditor\u662fanyOf string\u6216null\uff0c\u4f46required\u5217\u8868\u4e2d\u5305\u542beditor\u3002\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\uff0c\u5373\u4f7f\u4e3a\u7a7a\u3002\u56e0\u6b64\uff0c\u5728publication\u4e2d\uff0ceditor\u5b57\u6bb5\u5fc5\u987b\u5b58\u5728\uff0c\u503c\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u540c\u6837\uff0clibrary_reference\u4e2d\u7684shelfmark\u548csubjects\u90fd\u662frequired\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\uff0c\u5373\u4f7f\u4e3a\u7a7a\u3002\\n\\n\u56e0\u6b64\uff0c\u6700\u7ec8\u7684JSON\u9700\u8981\u5305\u542b\u6240\u6709required\u5b57\u6bb5\uff0c\u5373\u4f7f\u503c\u4e3a\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u73b0\u5728\u518d\u68c0\u67e5\u4f5c\u8005\u90e8\u5206\u3002\u5361\u7247\u4e2d\u7684\u7b2c\u4e00\u884c\u662f\u201cMontaghemi, Nourhomadeh\u201d\uff0c\u6240\u4ee5last_name\u662fMontaghemi\uff0cfirst_name\u662fNourhomadeh\u3002\u7b2c\u4e09\u884c\u662f\u201cSonnenbichler - Montaghemi, Nourhomadeh\u201d\uff0c\u8fd9\u53ef\u80fd\u8868\u793a\u53e6\u4e00\u4e2a\u4f5c\u8005\uff0c\u4f46\u6839\u636e\u89c4\u5219\uff0c\u53ea\u63d0\u53d6\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u4f5c\u8005\uff0c\u6240\u4ee5\u4f5c\u8005\u90e8\u5206\u6b63\u786e\u3002\\n\\n\u56e0\u6b64\uff0c\u6700\u7ec8\u7684JSON\u5e94\u8be5\u5982\u4e0a\u8ff0\u6240\u793a\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u4e2a\u7d22\u5f15\u5361\u56fe\u7247\uff0c\u5e76\u63d0\u53d6\u51fa\u7ed3\u6784\u5316\u7684JSON\u6570\u636e\u3002\u9996\u5148\uff0c\u6211\u5f97\u4ed4\u7ec6\u770b\u770b\u7528\u6237\u7ed9\u7684\u6307\u4ee4\u548c\u793a\u4f8b\uff0c\u786e\u4fdd\u81ea\u5df1\u7406\u89e3\u6b63\u786e\u3002\\n\\n\u9996\u5148\uff0c\u7528\u6237\u8981\u6c42\u6839\u636e\u7d22\u5f15\u5361\u7684\u5185\u5bb9\uff0c\u6309\u7167\u7279\u5b9a\u7684\u89c4\u5219\u63d0\u53d6\u4fe1\u606f\uff0c\u5e76\u751f\u6210\u7b26\u5408\u6307\u5b9aJSON Schema\u7684\u54cd\u5e94\u3002\u7528\u6237\u8fd8\u7279\u522b\u5f3a\u8c03\u8981\u4f7f\u7528\u7528\u6237\u7684\u8bed\u8a00\uff0c\u4e5f\u5c31\u662f\u4e2d\u6587\uff0c\u4f46\u8f93\u51fa\u5fc5\u987b\u662fJSON\uff0c\u5e76\u4e14\u4e0d\u80fd\u6709\u4efb\u4f55\u5176\u4ed6\u4fe1\u606f\u3002\\n\\n\u73b0\u5728\u6765\u770b\u63d0\u4f9b\u7684\u7d22\u5f15\u5361\u56fe\u7247\u5185\u5bb9\u3002\u56fe\u7247\u4e2d\u7684\u6587\u5b57\u662f\uff1a\\n\\nMontaghemi, Nourhomadeh\\ns.\\nSonnenbichler - Montaghemi, Nourhomadeh\\n\\n\u9996\u5148\uff0c\u6839\u636e\u89c4\u52191\uff0c\u5224\u65ad\u5361\u7247\u7c7b\u578b\u3002\u5982\u679c\u5361\u7247\u4e0a\u6709\u5355\u72ec\u7684\u201cs.\u201d\u884c\uff0c\u5219\u662f\u201cReference\u201d\uff0c\u5426\u5219\u662f\u201cDissertation or thesis\u201d\u3002\u8fd9\u91cc\u786e\u5b9e\u6709\u201cs.\u201d\u5355\u72ec\u4e00\u884c\uff0c\u6240\u4ee5\u7c7b\u578b\u5e94\u8be5\u662f\u201cReference\u201d\u3002\\n\\n\u63a5\u4e0b\u6765\u662f\u4f5c\u8005\u4fe1\u606f\u3002\u89c4\u52192\u6307\u51fa\uff0c\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\uff0c\u653e\u5728last_name\uff0cfirst_name\u7559\u7a7a\u3002\u4f46\u8fd9\u91cc\u7b2c\u4e00\u884c\u662f\u201cMontaghemi, Nourhomadeh\u201d\uff0c\u770b\u8d77\u6765\u662f\u59d3\u5728\u524d\uff0c\u540d\u5728\u540e\uff0c\u6240\u4ee5last_name\u662fMontaghemi\uff0cfirst_name\u662fNourhomadeh\u3002\u4e0d\u8fc7\u7b2c\u4e09\u884c\u53c8\u51fa\u73b0\u4e86\u201cSonnenbichler - Montaghemi, Nourhomadeh\u201d\uff0c\u8fd9\u53ef\u80fd\u662f\u4e00\u4e2a\u8054\u5408\u7f72\u540d\u6216\u8005\u53e6\u4e00\u4e2a\u4f5c\u8005\uff1f\u4f46\u6839\u636e\u89c4\u5219\uff0c\u53ef\u80fd\u53ea\u9700\u8981\u63d0\u53d6\u7b2c\u4e00\u4e2a\u51fa\u73b0\u7684\u4f5c\u8005\u3002\u6216\u8005\u53ef\u80fd\u201cSonnenbichler\u201d\u662f\u53e6\u4e00\u4e2a\u4f5c\u8005\uff0c\u4f46\u7528\u6237\u7ed9\u7684\u4f8b\u5b50\u4e2d\u53ef\u80fd\u53ea\u9700\u8981\u5904\u7406\u7b2c\u4e00\u4e2a\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u89c4\u5219\u3002\u89c4\u52192\u8bf4\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\uff0c\u653e\u5728last_name\uff0c\u4f46\u8fd9\u91cc\u6709\u4e24\u4e2a\u540d\u5b57\uff0c\u7528\u9017\u53f7\u5206\u9694\uff0c\u6240\u4ee5\u5e94\u8be5\u662flast_name\u662fMontaghemi\uff0cfirst_name\u662fNourhomadeh\u3002\u7b2c\u4e09\u884c\u53ef\u80fd\u662f\u4e00\u4e2a\u53c2\u8003\u6761\u76ee\uff0c\u6bd4\u5982\u6307\u5411\u53e6\u4e00\u4e2a\u4f5c\u8005\uff0c\u4f46\u6839\u636e\u89c4\u5219\uff0c\u53ef\u80fd\u4e0d\u9700\u8981\u5904\u7406\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u5ffd\u7565\u4e0d\u7b26\u5408\u7c7b\u522b\u7684\u4fe1\u606f\u3002\u6240\u4ee5\u4f5c\u8005\u90e8\u5206\u5e94\u8be5\u662flast_name: Montaghemi\uff0cfirst_name: Nourhomadeh\u3002\\n\\n\u7136\u540e\u662f\u51fa\u7248\u4fe1\u606f\u3002\u89c4\u52193\u4e2d\u7684\u5404\u4e2a\u5b57\u6bb5\u9700\u8981\u63d0\u53d6\u3002\u4f46\u5728\u8fd9\u4e2a\u5361\u7247\u4e2d\uff0c\u4f3c\u4e4e\u6ca1\u6709\u660e\u663e\u7684\u6807\u9898\u3001\u5e74\u4efd\u3001\u5730\u70b9\u3001\u9875\u6570\u3001\u51fa\u7248\u793e\u6216\u683c\u5f0f\u7684\u4fe1\u606f\u3002\u53ef\u80fd\u8fd9\u4e9b\u4fe1\u606f\u7f3a\u5931\uff0c\u6240\u4ee5\u6309\u7167\u89c4\u52195\uff0c\u7528\u7a7a\u5b57\u7b26\u4e32\u586b\u5145\u3002\u4f8b\u5982\uff0ctitle\u53ef\u80fd\u4e0d\u5b58\u5728\uff0c\u6240\u4ee5\u7559\u7a7a\u3002\u5e74\u4efd\u4e5f\u6ca1\u6709\uff0c\u6240\u4ee5\u53ef\u80fd\u4e0d\u586b\uff0c\u4f46\u6839\u636eschema\uff0cyear\u662f\u5fc5\u987b\u7684\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u793a\u4f8b\u91ccyear\u662f\u6574\u6570\uff0c\u4f46\u89c4\u52195\u8bf4\u5982\u679c\u7f3a\u5931\uff0c\u7701\u7565\u5e74\u4efd\u5b57\u6bb5\u3002\u4e0d\u8fc7\u67e5\u770b\u7528\u6237\u63d0\u4f9b\u7684JSON Schema\uff0cpublication\u4e2d\u7684year\u662f\u5fc5\u987b\u7684\uff0c\u7c7b\u578b\u662fstring\u3002\u8fd9\u91cc\u53ef\u80fd\u5b58\u5728\u77db\u76fe\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u63d0\u4f9b\u7684schema\u3002\\n\\n\u67e5\u770b\u7528\u6237\u63d0\u4f9b\u7684JSON Schema\uff0cpublication\u7684properties\u4e2dyear\u7684\u7c7b\u578b\u662fstring\uff0c\u4f46\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u793a\u4f8b\u91ccyear\u662f\u6574\u6570\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u7ed9\u7684schema\uff0cyear\u662fstring\u7c7b\u578b\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u4ee5\u5b57\u7b26\u4e32\u5f62\u5f0f\u5b58\u5728\u3002\u4f46\u89c4\u52195\u8bf4\u5982\u679c\u7f3a\u5931\uff0c\u7701\u7565\u5e74\u4efd\u5b57\u6bb5\u3002\u4f46schema\u4e2dyear\u662frequired\u7684\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\u3002\u8fd9\u53ef\u80fd\u662f\u4e00\u4e2a\u77db\u76fe\uff0c\u9700\u8981\u4ed4\u7ec6\u5904\u7406\u3002\\n\\n\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\u8f93\u51fa\uff0c\u53ef\u80fdyear\u5fc5\u987b\u5b58\u5728\uff0c\u4f46\u5982\u679c\u6ca1\u6709\u7684\u8bdd\uff0c\u53ef\u80fd\u9700\u8981\u7559\u7a7a\u5b57\u7b26\u4e32\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52195\u6709\u8bef\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u6307\u4ee4\u3002\\n\\n\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52195\uff1a\u201cMissing Information: Use empty string \\\"\\\" for missing text fields, omit year fields entirely if not present.\u201d \u4f46\u6839\u636e\u63d0\u4f9b\u7684JSON Schema\uff0cpublication\u4e2d\u7684year\u662frequired\u7684\uff0c\u7c7b\u578b\u662fstring\u3002\u6240\u4ee5\u8fd9\u91cc\u53ef\u80fd\u5b58\u5728\u77db\u76fe\u3002\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684schema\uff0cyear\u662f\u5fc5\u987b\u7684\uff0c\u6240\u4ee5\u5373\u4f7f\u6ca1\u6709\uff0c\u4e5f\u9700\u8981\u7559\u7a7a\u5b57\u7b26\u4e32\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u6307\u4ee4\u4e2d\u7684\u89c4\u52195\u6709\u8bef\uff0c\u5e94\u8be5\u6309\u7167schema\u6765\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u4ee5schema\u4e3a\u51c6\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u8fd4\u56de\u7684JSON\u5fc5\u987b\u7b26\u5408\u63d0\u4f9b\u7684schema\u3002\u56e0\u6b64\uff0c\u5373\u4f7f\u6ca1\u6709\u5e74\u4efd\uff0c\u4e5f\u9700\u8981\u5305\u542byear\u5b57\u6bb5\uff0c\u4f46\u503c\u4e3a\u7a7a\u5b57\u7b26\u4e32\uff1f\u4f46schema\u4e2dyear\u7684\u7c7b\u578b\u662fstring\uff0c\u6240\u4ee5\u53ef\u4ee5\u7559\u7a7a\u3002\u4f46\u6839\u636e\u89c4\u52195\uff0c\u5982\u679c\u5e74\u4efd\u4e0d\u5b58\u5728\uff0c\u5e94\u8be5\u7701\u7565\u8be5\u5b57\u6bb5\u3002\u4f46schema\u4e2dyear\u662frequired\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\u3002\u8fd9\u53ef\u80fd\u662f\u4e00\u4e2a\u51b2\u7a81\uff0c\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\\n\\n\u53ef\u80fd\u7528\u6237\u63d0\u4f9b\u7684schema\u4e2d\uff0cyear\u662f\u5fc5\u987b\u7684\uff0c\u4f46\u89c4\u52195\u8bf4\u5982\u679c\u7f3a\u5931\u5219\u7701\u7565\u3002\u8fd9\u53ef\u80fd\u662f\u4e00\u4e2a\u9519\u8bef\uff0c\u4f46\u4f5c\u4e3a\u6267\u884c\u8005\uff0c\u5fc5\u987b\u6309\u7167schema\u6765\uff0c\u56e0\u4e3a\u7528\u6237\u8981\u6c42\u8fd4\u56de\u7684JSON\u5fc5\u987b\u7b26\u5408\u8be5schema\u3002\u56e0\u6b64\uff0c\u5373\u4f7f\u6ca1\u6709\u5e74\u4efd\uff0c\u4e5f\u9700\u8981\u5305\u542byear\u5b57\u6bb5\uff0c\u4f46\u503c\u4e3a\u7a7a\u5b57\u7b26\u4e32\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5982\u679c\u5e74\u4efd\u4e0d\u5b58\u5728\uff0c\u5c31\u4e0d\u5305\u542b\u8be5\u5b57\u6bb5\uff0c\u4f46schema\u4e2dyear\u662frequired\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u786e\u8ba4\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u53ef\u80fd\u5e94\u8be5\u6309\u7167schema\u7684\u8981\u6c42\uff0c\u5373\u4f7f\u6ca1\u6709\u4fe1\u606f\uff0c\u4e5f\u8981\u4fdd\u7559\u5b57\u6bb5\uff0c\u7528\u7a7a\u5b57\u7b26\u4e32\u586b\u5145\u3002\u4f8b\u5982\uff0c\u5728publication\u4e2d\uff0c\u6240\u6709\u5b57\u6bb5\u90fd\u662frequired\uff0c\u6240\u4ee5\u5fc5\u987b\u5b58\u5728\uff0c\u5373\u4f7f\u4e3a\u7a7a\u3002\\n\\n\u73b0\u5728\u56de\u5230\u5361\u7247\u5185\u5bb9\uff0c\u8fd9
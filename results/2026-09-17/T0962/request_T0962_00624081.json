6e\u5b9e\u6709\u4e00\u4e2a\u5355\u72ec\u7684\u201cs.\u201d\uff0c\u6240\u4ee5type\u5e94\u8be5\u662f\u201cReference\u201d\u3002\\n\\n\u7136\u540e\u662f\u4f5c\u8005\u90e8\u5206\u3002\u89c4\u52192\u6307\u51fa\uff0c\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\uff0c\u653e\u5728last_name\uff0cfirst_name\u7559\u7a7a\u3002\u4f46\u8fd9\u91cc\u6709\u4e24\u4e2a\u540d\u5b57\uff1avan der Loeff, Michael Rutgers\u3002\u770b\u8d77\u6765\u53ef\u80fd\u662f\u4e00\u4e2a\u590d\u5408\u59d3\u6c0f\uff0c\u6bd4\u5982\u201cvan der Loeff\u201d\u662f\u59d3\u6c0f\uff0c\u800c\u201cMichael Rutgers\u201d\u662f\u540d\u5b57\u3002\u4e0d\u8fc7\u6709\u65f6\u5019\u8377\u5170\u59d3\u6c0f\u4e2d\u7684\u201cvan der\u201d\u53ef\u80fd\u5c5e\u4e8e\u59d3\u6c0f\u7684\u4e00\u90e8\u5206\u3002\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u201cvan der Loeff\u201d\u4f5c\u4e3alast_name\uff0c\u800c\u201cMichael Rutgers\u201d\u4f5c\u4e3afirst_name\u3002\u4e0d\u8fc7\u4e5f\u6709\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u201cRutgers\u201d\u4f5c\u4e3a\u4e2d\u95f4\u540d\uff0c\u4f46\u6839\u636e\u89c4\u5219\uff0c\u5982\u679c\u53ea\u6709\u4e00\u4e2a\u540d\u5b57\uff0c\u5c31\u653e\u5728last_name\u3002\u4f46\u8fd9\u91cc\u6709\u4e24\u4e2a\u90e8\u5206\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u62c6\u5206\u3002\u4f8b\u5982\uff0clast_name\u662f\u201cvan der Loeff\u201d\uff0cfirst_name\u662f\u201cMichael Rutgers\u201d\u3002\u4e0d\u8fc7\u4e5f\u6709\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u201cRutgers\u201d\u4f5c\u4e3a\u59d3\u6c0f\u7684\u4e00\u90e8\u5206\uff0c\u4f46\u6839\u636e\u5e38\u89c1\u7684\u547d\u540d\u4e60\u60ef\uff0c\u53ef\u80fd\u201cvan der Loeff\u201d\u662f\u59d3\u6c0f\uff0c\u800c\u201cMichael Rutgers\u201d\u662f\u540d\u5b57\u3002\u4e0d\u8fc7\u9700\u8981\u786e\u8ba4\u3002\\n\\n\u63a5\u4e0b\u6765\u662fpublication\u90e8\u5206\u3002\u6839\u636e\u89c4\u52193\uff0c\u9700\u8981\u63d0\u53d6title\u3001year\u3001place\u3001pages\u3001publisher\u3001format\u3002\u4f46\u7d22\u5f15\u5361\u4e2d\u4f3c\u4e4e\u6ca1\u6709\u8fd9\u4e9b\u4fe1\u606f\u3002\u4f8b\u5982\uff0c\u6ca1\u6709\u6807\u9898\uff0c\u6ca1\u6709\u5e74\u4efd\uff0c\u6ca1\u6709\u51fa\u7248\u5730\uff0c\u9875\u6570\uff0c\u51fa\u7248\u793e\u6216\u683c\u5f0f\u3002\u6240\u4ee5\u8fd9\u4e9b\u5b57\u6bb5\u90fd\u5e94\u8be5\u7559\u7a7a\u5b57\u7b26\u4e32\uff0c\u9664\u4e86year\u5982\u679c\u5b58\u5728\u7684\u8bdd\u3002\u4f46\u8fd9\u91cc\u6ca1\u6709\u5e74\u4efd\uff0c\u6240\u4ee5year\u5b57\u6bb5\u5e94\u8be5\u88ab\u7701\u7565\u5417\uff1f\u6839\u636e\u89c4\u52195\uff0c\u5982\u679c\u5e74\u4efd\u4e0d\u5b58\u5728\uff0c\u5e94\u8be5\u7701\u7565\u8be5\u5b57\u6bb5\u3002\u4f46\u6839\u636eSchema\uff0cpublication\u4e2d\u7684year\u662f\u5fc5\u987b\u7684\uff0c\u7c7b\u578b\u662fstring\u3002\u4e0d\u8fc7\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662fstring\u7c7b\u578b\uff0c\u4f46\u793a\u4f8b\u4e2d\u7684\u89c4\u52195\u8bf4\u5982\u679c\u5e74\u4efd\u4e0d\u5b58\u5728\uff0c\u5e94\u8be5\u7701\u7565\u3002\u4f46\u6839\u636eSchema\uff0cyear\u662f\u5fc5\u987b\u7684\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u77db\u76fe\u3002\u4e0d\u8fc7\u7528\u6237\u63d0\u4f9b\u7684Schema\u4e2d\uff0cpublication\u7684year\u662f\u5fc5\u987b\u7684\uff0c\u7c7b\u578b\u662fstring\uff0c\u4f46\u89c4\u52195\u8bf4\u5982\u679c\u4e0d\u5b58\u5728\uff0c\u5e94\u8be5\u7701\u7565\u3002\u8fd9\u53ef\u80fd\u5b58\u5728\u77db\u76fe\uff0c\u4f46\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684Schema\uff0c\u5fc5\u987b\u5305\u542byear\u5b57\u6bb5\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u7559\u7a7a\u5b57\u7b26\u4e32\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5982\u679c\u4e0d\u5b58\u5728\uff0c\u5c31\u7559\u7a7a\u5b57\u7b26\u4e32\u3002\u9700\u8981\u4ed4\u7ec6\u770b\u89c4\u5219\u3002\\n\\n\u89c4\u52195\u8bf4\uff1a\u201cMissing Information: Use empty string \\\"\\\" for missing text fields, omit year fields entirely if not present.\u201d \u8fd9\u91cc\u53ef\u80fd\u6709\u4e9b\u77db\u76fe\uff0c\u56e0\u4e3ayear\u5728Schema\u4e2d\u662f\u5fc5\u987b\u7684\uff0c\u4f46\u89c4\u
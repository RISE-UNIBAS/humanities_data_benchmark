    "raw_response": "{\"id\":\"gen-1789663667-p9EMOZDbDFSPsuZC5r8Q\",\"choices\":[{\"finish_reason\":\"stop\",\"index\":0,\"logprobs\":null,\"message\":{\"content\":\"{\\n  \\\"company\\\": {\\\"transcription\\\": \\\"Ott Martin\\\"},\\n  \\\"location\\\": {\\\"transcription\\\": \\\"Kloten\\\"},\\n  \\\"b_id\\\": {\\\"transcription\\\": \\\"B.51.322.GB.1285\\\"},\\n  \\\"date\\\": \\\"1945-11-23\\\",\\n  \\\"information\\\": [\\n    {\\\"transcription\\\": \\\"Britische schwarze Liste\\\\nAmendment 5, April 1944.\\\"},\\n    {\\\"transcription\\\": \\\"Gestrichen:\\\\nAmendment 13, 23.11.1945.\\\"}\\n  ]\\n}\",\"refusal\":null,\"role\":\"assistant\",\"annotations\":null,\"audio\":null,\"function_call\":null,\"tool_calls\":null,\"parsed\":{\"company\":{\"transcription\":\"Ott Martin\"},\"location\":{\"transcription\":\"Kloten\"},\"b_id\":{\"transcription\":\"B.51.322.GB.1285\"},\"date\":\"1945-11-23\",\"information\":[{\"transcription\":\"Britische schwarze Liste\\nAmendment 5, April 1944.\"},{\"transcription\":\"Gestrichen:\\nAmendment 13, 23.11.1945.\"}]},\"reasoning\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u5f20\u7d22\u5f15\u5361\u56fe\u7247\uff0c\u5e76\u6309\u7167\u4ed6\u4eec\u7684\u8981\u6c42\u63d0\u53d6\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u8981\u4ed4\u7ec6\u770b\u4e00\u4e0b\u7528\u6237\u7ed9\u7684\u6307\u793a\u548c\u793a\u4f8bJSON\u7ed3\u6784\uff0c\u786e\u4fdd\u81ea\u5df1\u5b8c\u5168\u7406\u89e3\u6bcf\u4e2a\u5b57\u6bb5\u7684\u8981\u6c42\u3002\\n\\n\u9996\u5148\uff0c\u7528\u6237\u8981\u6c42\u63d0\u53d6\u7684\u4fe1\u606f\u5305\u62ec\u516c\u53f8\uff08company\uff09\u3001\u5730\u70b9\uff08location\uff09\u3001BID\uff08b_id\uff09\u3001\u65e5\u671f\uff08date\uff09\u548c\u4fe1\u606f\uff08information\uff09\u3002\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u6709\u7279\u5b9a\u7684\u4f4d\u7f6e\u548c\u683c\u5f0f\u8981\u6c42\u3002\u6bd4\u5982\uff0c\u516c\u53f8\u901a\u5e38\u5728\u5de6\u4e0a\u89d2\uff0c\u5730\u70b9\u7d27\u968f\u5176\u540e\uff0cBID\u5728\u53f3\u4e0a\u89d2\u4ee5\u201cB.\u201d\u5f00\u5934\uff0c\u65e5\u671f\u5982\u679c\u6709\u5219\u7528YYYY-MM-DD\u683c\u5f0f\uff0c\u5426\u5219\u7559\u7a7a\u3002\u4fe1\u606f\u90e8\u5206\u662f\u4e3b\u4f53\u4e2d\u7684\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u7b26\u3002\\n\\n\u73b0\u5728\u770b\u56fe\u7247\u5185\u5bb9\u3002\u5de6\u4e0a\u89d2\u662f\u201cOtt Martin, Kloten.\u201d\uff0c\u8fd9\u91cc\u516c\u53f8\u5e94\u8be5\u662f\u201cOtt Martin\u201d\uff0c\u800c\u5730\u70b9\u662f\u201cKloten\u201d\u3002\u4e0d\u8fc7\u8981\u6ce8\u610f\uff0c\u7528\u6237\u8bf4\u660e\u8981\u6392\u9664\u5730\u70b9\uff0c\u6240\u4ee5\u516c\u53f8\u5b57\u6bb5\u53ea\u4fdd\u7559\u201cOtt Martin\u201d\uff0c\u800c\u5730\u70b9\u5355\u72ec\u4f5c\u4e3a\u201cKloten\u201d\u3002\u53f3\u4e0a\u89d2\u7684BID\u662f\u201cB.51.322.GB.1285.\u201d\uff0c\u9700\u8981\u786e\u8ba4\u662f\u5426\u4ee5B.\u5f00\u5934\uff0c\u662f\u7684\uff0c\u6240\u4ee5\u76f4\u63a5\u63d0\u53d6\u3002\\n\\n\u63a5\u4e0b\u6765\u662f\u65e5\u671f\u90e8\u5206\u3002\u56fe\u7247\u4e2d\u6709\u4e24\u4e2a\u65e5\u671f\uff1a\u201cApril 1944\u201d\u548c\u201c23.11.1945\u201d\u3002\u7528\u6237\u8981\u6c42\u7684\u662f stamped dates\uff0c\u4e5f\u5c31\u662f\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u3002\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u660e\u786e\u7684\u65e5\u671f\u683c\u5f0f\u3002\u7b2c\u4e00\u4e2a\u662f\u201cAmendment 5, April 1944\u201d\uff0c\u7b2c\u4e8c\u4e2a\u662f\u201cAmendment 13, 23.11.1945\u201d\u3002\u7528\u6237\u8981\u6c42\u65e5\u671f\u683c\u5f0f\u4e3aYYYY-MM-DD\uff0c\u6240\u4ee5\u7b2c\u4e8c\u4e2a\u65e5\u671f\u53ef\u4ee5\u8f6c\u6362\u4e3a1945-11-23\uff0c\u800c\u7b2c\u4e00\u4e2a\u53ea\u6709\u6708\u4efd\u548c\u5e74\u4efd\uff0c\u53ef\u80fd\u65e0\u6cd5\u8f6c\u6362\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e8c\u4e2a\u3002\u4f46\u7528\u6237\u6307\u793a\u8bf4\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u6839\u636e\u793a\u4f8b\u4e2d\u7684JSON\uff0cdate\u5b57\u6bb5\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u53ea\u53d6\u5176\u4e2d\u4e00\u4e2a\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cAny stamped dates on the card in YYYY-MM-DD format\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e00\u4e2a\u6216\u6700\u540e\u4e00\u4e2a\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u591a\u4e2a\u65e5\u671f\u5408\u5e76\uff1f\u4f46\u6839\u636e\u793a\u4f8b\u4e2d\u7684JSON\u7ed3\u6784\uff0cdate\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u5176\u4e2d\u4e00\u4e2a\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u7b2c\u4e8c\u4e2a\u65e5\u671f\u662f\u201c23.11.1945\u201d\uff0c\u53ef\u4ee5\u8f6c\u6362\u4e3a1945-11-23\uff0c\u800c\u7b2c\u4e00\u4e2a\u662fApril 1944\uff0c\u65e0\u6cd5\u8f6c\u6362\u4e3a\u5b8c\u6574\u65e5\u671f\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e8c\u4e2a\u3002\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u653e\u5728date\u5b57\u6bb5\u91cc\uff0c\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u4f5c\u4e3a\u4fe1\u606f\u90e8\u5206\u7684\u5185\u5bb9\uff0c\u800cdate\u5b57\u6bb5\u7559\u7a7a\uff1f\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u6307\u793a\u3002\\n\\n\u7528\u6237\u6307\u793a\u4e2ddate\u5b57\u6bb5\u662f\u201cAny stamped dates on the card in YYYY-MM-DD format. If no date is present, use an empty string.\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u683c\u5f0f\u5fc5\u987b\u7b26\u5408YYYY-MM-DD\u3002\u7b2c\u4e00\u4e2a\u65e5\u671f\u662fApril 1944\uff0c\u65e0\u6cd5\u8f6c\u6362\u4e3a\u5b8c\u6574\u65e5\u671f\uff0c\u6240\u4ee5\u53ef\u80fd\u5ffd\u7565\uff0c\u800c\u7b2c\u4e8c\u4e2a\u662f23.11.1945\uff0c\u53ef\u4ee5\u8f6c\u6362\u4e3a1945-11-23\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u5e94\u8be5\u662f\u201c1945-11-23\u201d\u3002\\n\\n\u7136\u540e\u662f\u4fe1\u606f\u90e8\u5206\uff0c\u4e3b\u4f53\u4e2d\u7684\u6587\u672c\u5757\u3002\u56fe\u7247\u4e2d\u7684\u4e3b\u4f53\u90e8\u5206\u6709\u4e24\u6bb5\uff1a\u201cBritische schwarze Liste\\\\nAmendment 5, April 1944.\u201d\u548c\u201cGestrichen:\\\\nAmendment 13, 23.11.1945.\u201d\u3002\u6bcf\u4e2a\u5757\u5e94\u8be5\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u7b26\u3002\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u4f1a\u6709\u4e24\u4e2a\u5143\u7d20\uff0c\u6bcf\u4e2a\u5143\u7d20\u662f\u8fd9\u4e24\u4e2a\u6587\u672c\u5757\uff0c\u7528\\\\n\u5206\u9694\u884c\u3002\\n\\n\u73b0\u5728\u68c0\u67e5\u6bcf\u4e2a\u5b57\u6bb5\u662f\u5426\u7b26\u5408\u8981\u6c42\uff1a\\n\\n\u516c\u53f8\uff1aOtt Martin\uff0c\u6b63\u786e\uff0c\u6392\u9664\u5730\u70b9Kloten\u3002\\n\\n\u5730\u70b9\uff1aKloten\uff0c\u6b63\u786e\u3002\\n\\nBID\uff1aB.51.322.GB.1285.\uff0c\u6b63\u786e\uff0c\u4ee5B.\u5f00\u5934\u3002\\n\\n\u65e5\u671f\uff1a1945-11-23\uff0c\u6b63\u786e\u8f6c\u6362\u3002\\n\\n\u4fe1\u606f\uff1a\u4e24\u4e2a\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u4f5c\u4e3a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u3002\\n\\n\u73b0\u5728\u9700\u8981\u786e\u4fddJSON\u7ed3\u6784\u6b63\u786e\uff0c\u6bcf\u4e2a\u5b57\u6bb5\u7684transcription\u662f\u5426\u6b63\u786e\uff0c\u4ee5\u53ca\u662f\u5426\u6709\u9057\u6f0f\u3002\u4f8b\u5982\uff0c\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u53ef\u80fd\u7684\u65e5\u671f\u6216\u4fe1\u606f\u5757\u3002\u56fe\u7247\u5e95\u90e8\u6709\u201c74463\u201d\uff0c\u4f46\u7528\u6237\u6ca1\u6709\u63d0\u5230\u9700\u8981\u63d0\u53d6\u8fd9\u4e2a\uff0c\u6240\u4ee5\u5ffd\u7565\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fddJSON\u683c\u5f0f\u6b63\u786e\uff0c\u6ca1\u6709\u989d\u5916\u7684\u5b57\u6bb5\uff0c\u6240\u6709required\u5b57\u6bb5\u90fd\u5b58\u5728\uff0c\u4e14\u7c7b\u578b\u6b63\u786e\u3002\u4f8b\u5982\uff0cdate\u662f\u5b57\u7b26\u4e32\uff0cinformation\u662f\u6570\u7ec4\uff0c\u6bcf\u4e2a\u5143\u7d20\u662f\u5bf9\u8c61\u5305\u542btranscription\u3002\\n\\n\u73b0\u5728\u7ec4\u5408\u8fd9\u4e9b\u5185\u5bb9\u5230JSON\u7ed3\u6784\u4e2d\uff0c\u786e\u4fdd\u7b26\u5408\u7528\u6237\u63d0\u4f9b\u7684schema\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u5f20\u7d22\u5f15\u5361\u56fe\u7247\uff0c\u5e76\u6309\u7167\u4ed6\u4eec\u7684\u8981\u6c42\u63d0\u53d6\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u8981\u4ed4\u7ec6\u770b\u4e00\u4e0b\u7528\u6237\u7ed9\u7684\u6307\u793a\u548c\u793a\u4f8bJSON\u7ed3\u6784\uff0c\u786e\u4fdd\u81ea\u5df1\u5b8c\u5168\u7406\u89e3\u6bcf\u4e2a\u5b57\u6bb5\u7684\u8981\u6c42\u3002\\n\\n\u9996\u5148\uff0c\u7528\u6237\u8981\u6c42\u63d0\u53d6\u7684\u4fe1\u606f\u5305\u62ec\u516c\u53f8\uff08company\uff09\u3001\u5730\u70b9\uff08location\uff09\u3001BID\uff08b_id\uff09\u3001\u65e5\u671f\uff08date\uff09\u548c\u4fe1\u606f\uff08information\uff09\u3002\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u6709\u7279\u5b9a\u7684\u4f4d\u7f6e\u548c\u683c\u5f0f\u8981\u6c42\u3002\u6bd4\u5982\uff0c\u516c\u53f8\u901a\u5e38\u5728\u5de6\u4e0a\u89d2\uff0c\u5730\u70b9\u7d27\u968f\u5176\u540e\uff0cBID\u5728\u53f3\u4e0a\u89d2\u4ee5\u201cB.\u201d\u5f00\u5934\uff0c\u65e5\u671f\u5982\u679c\u6709\u5219\u7528YYYY-MM-DD\u683c\u5f0f\uff0c\u5426\u5219\u7559\u7a7a\u3002\u4fe1\u606f\u90e8\u5206\u662f\u4e3b\u4f53\u4e2d\u7684\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5217\u8868\u4e2d\u7684\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u7b26\u3002\\n\\n\u73b0\u5728\u770b\u56fe\u7247\u5185\u5bb9\u3002\u5de6\u4e0a\u89d2\u662f\u201cOtt Martin, Kloten.\u201d\uff0c\u8fd9\u91cc\u516c\u53f8\u5e94\u8be5\u662f\u201cOtt Martin\u201d\uff0c\u800c\u5730\u70b9\u662f\u201cKloten\u201d\u3002\u4e0d\u8fc7\u8981\u6ce8\u610f\uff0c\u7528\u6237\u8bf4\u660e\u8981\u6392\u9664\u5730\u70b9\uff0c\u6240\u4ee5\u516c\u53f8\u5b57\u6bb5\u53ea\u4fdd\u7559\u201cOtt Martin\u201d\uff0c\u800c\u5730\u70b9\u5355\u72ec\u4f5c\u4e3a\u201cKloten\u201d\u3002\u53f3\u4e0a\u89d2\u7684BID\u662f\u201cB.51.322.GB.1285.\u201d\uff0c\u9700\u8981\u786e\u8ba4\u662f\u5426\u4ee5B.\u5f00\u5934\uff0c\u662f\u7684\uff0c\u6240\u4ee5\u76f4\u63a5\u63d0\u53d6\u3002\\n\\n\u63a5\u4e0b\u6765\u662f\u65e5\u671f\u90e8\u5206\u3002\u56fe\u7247\u4e2d\u6709\u4e24\u4e2a\u65e5\u671f\uff1a\u201cApril 1944\u201d\u548c\u201c23.11.1945\u201d\u3002\u7528\u6237\u8981\u6c42\u7684\u662f stamped dates\uff0c\u4e5f\u5c31\u662f\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u53ef\u80fd\u8fd9\u4e24\u4e2a\u90fd\u662f\u3002\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u660e\u786e\u7684\u65e5\u671f\u683c\u5f0f\u3002\u7b2c\u4e00\u4e2a\u662f\u201cAmendment 5, April 1944\u201d\uff0c\u7b2c\u4e8c\u4e2a\u662f\u201cAmendment 13, 23.11.1945\u201d\u3002\u7528\u6237\u8981\u6c42\u65e5\u671f\u683c\u5f0f\u4e3aYYYY-MM-DD\uff0c\u6240\u4ee5\u7b2c\u4e8c\u4e2a\u65e5\u671f\u53ef\u4ee5\u8f6c\u6362\u4e3a1945-11-23\uff0c\u800c\u7b2c\u4e00\u4e2a\u53ea\u6709\u6708\u4efd\u548c\u5e74\u4efd\uff0c\u53ef\u80fd\u65e0\u6cd5\u8f6c\u6362\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e8c\u4e2a\u3002\u4f46\u7528\u6237\u6307\u793a\u8bf4\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u6839\u636e\u793a\u4f8b\u4e2d\u7684JSON\uff0cdate\u5b57\u6bb5\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u53ea\u53d6\u5176\u4e2d\u4e00\u4e2a\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u7684\u8981\u6c42\u3002\u7528\u6237\u8bf4\u201cAny stamped dates on the card in YYYY-MM-DD format\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u793a\u4f8b\u4e2d\u7684date\u5b57\u6bb5\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e00\u4e2a\u6216\u6700\u540e\u4e00\u4e2a\uff1f\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u591a\u4e2a\u65e5\u671f\u5408\u5e76\uff1f\u4f46\u6839\u636e\u793a\u4f8b\u4e2d\u7684JSON\u7ed3\u6784\uff0cdate\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u5176\u4e2d\u4e00\u4e2a\u3002\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u5224\u65ad\u54ea\u4e2a\u662f\u4e3b\u8981\u7684\u65e5\u671f\u3002\u4f8b\u5982\uff0c\u7b2c\u4e8c\u4e2a\u65e5\u671f\u662f\u201c23.11.1945\u201d\uff0c\u53ef\u4ee5\u8f6c\u6362\u4e3a1945-11-23\uff0c\u800c\u7b2c\u4e00\u4e2a\u662fApril 1944\uff0c\u65e0\u6cd5\u8f6c\u6362\u4e3a\u5b8c\u6574\u65e5\u671f\uff0c\u6240\u4ee5\u53ef\u80fd\u53ea\u53d6\u7b2c\u4e8c\u4e2a\u3002\u6216\u8005\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u653e\u5728date\u5b57\u6bb5\u91cc\uff0c\u4f46\u6839\u636e\u793a\u4f8b\uff0cdate\u662f\u5355\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u9009\u62e9\u5176\u4e2d\u4e00\u4e2a\u3002\u6216\u8005\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u4e24\u4e2a\u65e5\u671f\u90fd\u4f5c\u4e3a\u4fe1\u606f\u90e8\u5206\u7684\u5185\u5bb9\uff0c\u800cdate\u5b57\u6bb5\u7559\u7a7a\uff1f\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u7528\u6237\u6307\u793a\u3002\\n\\n\u7528\u6237\u6307\u793a\u4e2ddate\u5b57\u6bb5\u662f\u201cAny stamped dates on the card in YYYY-MM-DD format. If no date is present, use an empty string.\u201d\uff0c\u6240\u4ee5\u5982\u679c\u6709\u591a\u4e2a\u65e5\u671f\uff0c\u53ef\u80fd\u9700\u8981\u90fd\u63d0\u53d6\uff0c\u4f46\u683c\u5f0f\u5fc5\u987b\u7b26\u5408YYYY-MM-DD\u3002\u7b2c\u4e00\u4e2a\u65e5\u671f\u662fApril 1944\uff0c\u65e0\u6cd5\u8f6c\u6362\u4e3a\u5b8c\u6574\u65e5\u671f\uff0c\u624
u6765\u662f\u4fe1\u606f\u90e8\u5206\uff0c\u9700\u8981\u63d0\u53d6\u4e3b\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u7b26\u3002\u4e3b\u6587\u672c\u90e8\u5206\u6709\u4e24\u6bb5\uff1a\u7b2c\u4e00\u6bb5\u662f\u201cBritische schwarze Liste, Amendment 14, Oktober 1943.\u201d\uff0c\u7b2c\u4e8c\u6bb5\u662f\u201cgestrichen: Amendment 3, Februar 1945.\u201d\u3002\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u5b57\u7b26\u4e32\uff0c\u6bcf\u4e2a\u4f5c\u4e3a\u4e00\u4e2a\u5143\u7d20\u3002\\n\\n\u73b0\u5728\u68c0\u67e5\u6bcf\u4e2a\u5b57\u6bb5\u662f\u5426\u7b26\u5408\u8981\u6c42\u3002\u516c\u53f8\u540d\u79f0\u6b63\u786e\uff0c\u5730\u70b9\u6b63\u786e\uff0cb_id\u6b63\u786e\uff0c\u65e5\u671f\u7559\u7a7a\uff0c\u4fe1\u606f\u90e8\u5206\u6b63\u786e\u3002\u9700\u8981\u786e\u4fddJSON\u7ed3\u6784\u6b63\u786e\uff0c\u6ca1\u6709\u591a\u4f59\u7684\u5185\u5bb9\uff0c\u5e76\u4e14\u4f7f\u7528\u6b63\u786e\u7684\u8f6c\u4e49\u7b26\uff0c\u6bd4\u5982\u6362\u884c\u7b26\u7528\\\\n\u3002\u4e0d\u8fc7\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u4fe1\u606f\u5757\u662f\u4e24\u884c\uff0c\u4f46\u6bcf\u4e2a\u5757\u53ef\u80fd\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6bb5\u548c\u7b2c\u4e8c\u6bb5\u5404\u5360\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u7528\u6362\u884c\u7b26\u5206\u9694\u7684\u8bdd\u53ef\u80fd\u9700\u8981\u5408\u5e76\uff0c\u4f46\u6839\u636e\u7528\u6237\u793a\u4f8b\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\u3002\u4e0d\u8fc7\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u6570\u7ec4\u6bcf\u4e2a\u5143\u7d20\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e0a\u7684\u4e24\u884c\u4fe1\u606f\u53ef\u80fd\u5206\u6210\u4e24\u4e2a\u6761\u76ee\uff0c\u4f46\u9700\u8981\u770b\u5b9e\u9645\u6392\u7248\u3002\\n\\n\u4ed4\u7ec6\u770b\u56fe\u7247\uff0c\u4e3b\u6587\u672c\u90e8\u5206\u6709\u4e24\u884c\uff1a\u7b2c\u4e00\u884c\u662f\u201cBritische schwarze Liste, Amendment 14, Oktober 1943.\u201d\uff0c\u7136\u540e\u6362\u884c\u540e\u662f\u201cgestrichen: Amendment 3, Februar 1945.\u201d\u3002\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u5e94\u8be5\u6709\u4e24\u4e2a\u5143\u7d20\uff0c\u6bcf\u4e2a\u5143\u7d20\u5bf9\u5e94\u4e00\u4e2a\u6bb5\u843d\uff0c\u7528\u6362\u884c\u7b26\u5206\u9694\u7684\u8bdd\u53ef\u80fd\u9700\u8981\u5408\u5e76\uff0c\u4f46\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u6570\u7ec4\u6bcf\u4e2a\u5143\u7d20\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u4f1a\u6709\u4e24\u4e2a\u5143\u7d20\u3002\u4f46\u9700\u8981\u786e\u8ba4\u7528\u6237\u662f\u5426\u5e0c\u671b\u5c06\u540c\u4e00\u5757\u4e2d\u7684\u6362\u884c\u7b26\u7528\\\\n\u8868\u793a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4fe1\u606f\u5757\u4e2d\u6709\u6362\u884c\uff0c\u5e94\u8be5\u7528\\\\n\u8fde\u63a5\u3002\u4f46\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u4e24\u4e2a\u6bb5\u843d\u662f\u5206\u5f00\u7684\uff0c\u6240\u4ee5\u53ef\u80fd\u4f5c\u4e3a\u4e24\u4e2a\u4e0d\u540c\u7684\u5b57\u7b26\u4e32\u3002\\n\\n\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u4fe1\u606f\u6570\u7ec4\u4e2d\u7684\u6bcf\u4e2a\u5143\u7d20\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e0a\u7684\u4e24\u4e2a\u6bb5\u843d\u5e94\u8be5\u4f5c\u4e3a\u4e24\u4e2a\u4e0d\u540c\u7684\u6761\u76ee\uff0c\u6bcf\u4e2a\u6761\u76ee\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\u3002\u56e0\u6b64\uff0c\u4fe1\u606f\u6570\u7ec4\u5e94\u8be5\u5305\u542b\u4e24\u4e2a\u5bf9\u8c61\uff0c\u6bcf\u4e2a\u5bf9\u8c61\u7684transcription\u5b57\u6bb5\u5bf9\u5e94\u4e00\u4e2a\u6bb5\u843d\u3002\\n\\n\u73b0\u5728\u786e\u8ba4\u6240\u6709\u5b57\u6bb5\u662f\u5426\u6b63\u786e\uff1a\\n\\ncompany: Tabador S.A.\\n\\nlocation: Gen\u00e8ve\\n\\nb_id: B.51.322.GB.1155.\\n\\ndate: \u7a7a\u5b57\u7b26\u4e32\uff0c\u56e0\u4e3a\u6ca1\u6709\u660e\u786e\u7684\u65e5\u671f\u6233\uff0c\u800c\u4fe1\u606f\u4e2d\u7684\u65e5\u671f\u662f\u6587\u672c\u5185\u5bb9\u3002\\n\\ninformation: \u4e24\u4e2a\u6761\u76ee\uff0c\u5206\u522b\u662f\u201cBritische schwarze Liste, Amendment 14, Oktober 1943.\u201d\u548c\u201cgestrichen: Amendment 3, Februar 1945.\u201d\\n\\n\u68c0\u67e5JSON\u7ed3\u6784\u662f\u5426\u7b26\u5408\u7528\u6237\u63d0\u4f9b\u7684schema\uff0c\u786e\u4fdd\u6bcf\u4e2a\u5b57\u6bb5\u90fd\u662f\u6b63\u786e\u7684\u7c7b\u578b\uff0c\u6ca1\u6709\u989d\u5916\u7684\u5c5e\u6027\u3002\u4f8b\u5982\uff0c\u6bcf\u4e2a\u5bf9\u8c61\u4e2d\u7684transcription\u5b57\u6bb5\u5fc5\u987b\u5b58\u5728\uff0c\u4e14\u4e3a\u5b57\u7b26\u4e32\u3002\u65e5\u671f\u5b57\u6bb5\u662f\u5b57\u7b26\u4e32\u6216null\uff0c\u8fd9\u91cc\u7559\u7a7a\u5b57\u7b26\u4e32\u3002\\n\\n\u6700\u540e\uff0c\u786e\u4fddJSON\u683c\u5f0f\u6b63\u786e\uff0c\u6ca1\u6709\u8bed\u6cd5\u9519\u8bef\uff0c\u6bd4\u5982\u5f15\u53f7\u95ed\u5408\uff0c\u9017\u53f7\u6b63\u786e\u7b49\u3002\",\"reasoning_details\":[{\"type\":\"reasoning.text\",\"text\":\"\u597d\u7684\uff0c\u6211\u73b0\u5728\u9700\u8981\u5904\u7406\u7528\u6237\u63d0\u4f9b\u7684\u8fd9\u4e2a\u7d22\u5f15\u5361\u56fe\u7247\uff0c\u5e76\u6309\u7167\u4ed6\u4eec\u7684\u8981\u6c42\u63d0\u53d6\u4fe1\u606f\u3002\u9996\u5148\uff0c\u6211\u5f97\u4ed4\u7ec6\u770b\u770b\u7528\u6237\u7ed9\u7684\u6307\u793a\uff0c\u786e\u4fdd\u81ea\u5df1\u7406\u89e3\u6bcf\u4e2a\u5b57\u6bb5\u7684\u8981\u6c42\u3002\\n\\n\u9996\u5148\uff0c\u7528\u6237\u8981\u6c42\u63d0\u53d6\u516c\u53f8\u540d\uff0c\u901a\u5e38\u5728\u5de6\u4e0a\u89d2\uff0c\u4e0d\u5305\u62ec\u5730\u70b9\u3002\u56fe\u7247\u5de6\u4e0a\u89d2\u663e\u793a\u7684\u662f\u201cTabador S.A.,\u201d\uff0c\u6240\u4ee5\u516c\u53f8\u540d\u5e94\u8be5\u662f\u201cTabador S.A.\u201d\u3002\u63a5\u4e0b\u6765\u662f\u5730\u70b9\uff0c\u901a\u5e38\u5728\u516c\u53f8\u540d\u79f0\u540e\u9762\uff0c\u8fd9\u91cc\u8ddf\u7740\u7684\u662f\u201cGen\u00e8ve\u201d\uff0c\u4e5f\u5c31\u662f\u65e5\u5185\u74e6\uff0c\u6240\u4ee5\u5730\u70b9\u586b\u201cGen\u00e8ve\u201d\u3002\\n\\n\u7136\u540e\u662fb_id\uff0c\u4e5f\u5c31\u662f\u6807\u8bc6\u7b26\u4ee3\u7801\uff0c\u901a\u5e38\u5728\u53f3\u4e0a\u89d2\uff0c\u4ee5\u201cB.\u201d\u5f00\u5934\u3002\u53f3\u4e0a\u89d2\u7684\u4ee3\u7801\u662f\u201cB.51.322.GB.1155.\u201d\uff0c\u6240\u4ee5\u76f4\u63a5\u63d0\u53d6\u8fd9\u4e2a\u3002\u65e5\u671f\u90e8\u5206\uff0c\u7528\u6237\u8981\u6c42\u7684\u662f\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u683c\u5f0f\u4e3aYYYY-MM-DD\u3002\u56fe\u7247\u4e2d\u6709\u4e24\u4e2a\u65e5\u671f\uff1a\u201cOktober 1943\u201d\u548c\u201cFebruar 1945\u201d\uff0c\u4f46\u9700\u8981\u8f6c\u6362\u6210\u6807\u51c6\u683c\u5f0f\u3002\u4e0d\u8fc7\u7528\u6237\u53ef\u80fd\u5e0c\u671b\u4fdd\u7559\u539f\u59cb\u65e5\u671f\uff0c\u4f46\u6839\u636e\u6307\u793a\uff0c\u5982\u679c\u6ca1\u6709\u660e\u786e\u7684\u65f6\u95f4\u6233\uff0c\u53ef\u80fd\u9700\u8981\u7559\u7a7a\u3002\u4e0d\u8fc7\u8fd9\u91cc\u53ef\u80fd\u7528\u6237\u5e0c\u671b\u5c06\u8fd9\u4e24\u4e2a\u65e5\u671f\u4f5c\u4e3a\u4fe1\u606f\u5757\u5904\u7406\uff0c\u800cdate\u5b57\u6bb5\u53ef\u80fd\u7559\u7a7a\uff0c\u56e0\u4e3a\u53ef\u80fd\u6ca1\u6709\u5177\u4f53\u7684\u65e5\u671f\u6233\u3002\u9700\u8981\u518d\u4ed4\u7ec6\u770b\u4e00\u4e0b\u6307\u793a\u3002\\n\\n\u7528\u6237\u63d0\u5230\u201cdate\u201d\u662f\u4efb\u4f55\u76d6\u7ae0\u7684\u65e5\u671f\uff0c\u4f46\u56fe\u7247\u4e2d\u7684\u65e5\u671f\u53ef\u80fd\u4e0d\u662f\u76d6\u7ae0\u7684\uff0c\u800c\u662f\u624b\u5199\u7684\u3002\u4f8b\u5982\uff0c\u201cAmendment 14, Oktober 1943\u201d\u548c\u201cgestrichen: Amendment 3, Februar 1945\u201d\u53ef\u80fd\u5c5e\u4e8e\u4fe1\u606f\u5757\u7684\u5185\u5bb9\uff0c\u800c\u4e0d\u662f\u5355\u72ec\u7684\u65e5\u671f\u6233\u3002\u56e0\u6b64\uff0cdate\u5b57\u6bb5\u53ef\u80fd\u7559\u7a7a\uff0c\u56e0\u4e3a\u53ef\u80fd\u6ca1\u6709\u660e\u786e\u7684\u65e5\u671f\u6233\uff0c\u800c\u4fe1\u606f\u5757\u4e2d\u7684\u65e5\u671f\u4f5c\u4e3a\u6587\u672c\u5904\u7406\u3002\\n\\n\u63a5\u4e0b\u6765\u662f\u4fe1\u606f\u90e8\u5206\uff0c\u9700\u8981\u63d0\u53d6\u4e3b\u6587\u672c\u5757\uff0c\u6bcf\u4e2a\u5757\u4f5c\u4e3a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\uff0c\u4fdd\u7559\u6362\u884c\u7b26\u3002\u4e3b\u6587\u672c\u90e8\u5206\u6709\u4e24\u6bb5\uff1a\u7b2c\u4e00\u6bb5\u662f\u201cBritische schwarze Liste, Amendment 14, Oktober 1943.\u201d\uff0c\u7b2c\u4e8c\u6bb5\u662f\u201cgestrichen: Amendment 3, Februar 1945.\u201d\u3002\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u5e94\u8be5\u5305\u542b\u8fd9\u4e24\u4e2a\u5b57\u7b26\u4e32\uff0c\u6bcf\u4e2a\u4f5c\u4e3a\u4e00\u4e2a\u5143\u7d20\u3002\\n\\n\u73b0\u5728\u68c0\u67e5\u6bcf\u4e2a\u5b57\u6bb5\u662f\u5426\u7b26\u5408\u8981\u6c42\u3002\u516c\u53f8\u540d\u79f0\u6b63\u786e\uff0c\u5730\u70b9\u6b63\u786e\uff0cb_id\u6b63\u786e\uff0c\u65e5\u671f\u7559\u7a7a\uff0c\u4fe1\u606f\u90e8\u5206\u6b63\u786e\u3002\u9700\u8981\u786e\u4fddJSON\u7ed3\u6784\u6b63\u786e\uff0c\u6ca1\u6709\u591a\u4f59\u7684\u5185\u5bb9\uff0c\u5e76\u4e14\u4f7f\u7528\u6b63\u786e\u7684\u8f6c\u4e49\u7b26\uff0c\u6bd4\u5982\u6362\u884c\u7b26\u7528\\\\n\u3002\u4e0d\u8fc7\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u4fe1\u606f\u5757\u662f\u4e24\u884c\uff0c\u4f46\u6bcf\u4e2a\u5757\u53ef\u80fd\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u7b2c\u4e00\u6bb5\u548c\u7b2c\u4e8c\u6bb5\u5404\u5360\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u7528\u6362\u884c\u7b26\u5206\u9694\u7684\u8bdd\u53ef\u80fd\u9700\u8981\u5408\u5e76\uff0c\u4f46\u6839\u636e\u7528\u6237\u793a\u4f8b\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u5b57\u7b26\u4e32\u3002\u4e0d\u8fc7\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u6570\u7ec4\u6bcf\u4e2a\u5143\u7d20\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4f8b\u5982\uff0c\u539f\u5361\u7247\u4e0a\u7684\u4e24\u884c\u4fe1\u606f\u53ef\u80fd\u5206\u6210\u4e24\u4e2a\u6761\u76ee\uff0c\u4f46\u9700\u8981\u770b\u5b9e\u9645\u6392\u7248\u3002\\n\\n\u4ed4\u7ec6\u770b\u56fe\u7247\uff0c\u4e3b\u6587\u672c\u90e8\u5206\u6709\u4e24\u884c\uff1a\u7b2c\u4e00\u884c\u662f\u201cBritische schwarze Liste, Amendment 14, Oktober 1943.\u201d\uff0c\u7136\u540e\u6362\u884c\u540e\u662f\u201cgestrichen: Amendment 3, Februar 1945.\u201d\u3002\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u5e94\u8be5\u6709\u4e24\u4e2a\u5143\u7d20\uff0c\u6bcf\u4e2a\u5143\u7d20\u5bf9\u5e94\u4e00\u4e2a\u6bb5\u843d\uff0c\u7528\u6362\u884c\u7b26\u5206\u9694\u7684\u8bdd\u53ef\u80fd\u9700\u8981\u5408\u5e76\uff0c\u4f46\u7528\u6237\u793a\u4f8b\u4e2d\u7684\u4fe1\u606f\u6570\u7ec4\u6bcf\u4e2a\u5143\u7d20\u662f\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5355\u72ec\u7684\u6761\u76ee\u3002\u4e0d\u8fc7\u6839\u636e\u7528\u6237\u63d0\u4f9b\u7684\u793a\u4f8b\uff0c\u53ef\u80fd\u6bcf\u4e2a\u6bb5\u843d\u4f5c\u4e3a\u4e00\u4e2a\u5b57\u7b26\u4e32\uff0c\u6240\u4ee5\u4fe1\u606f\u6570\u7ec4\u4f1a\u6709\u4e24\u4e2a\u5143\u7d20\u3002\u4f46\u9700\u8981\u786e\u8ba4\u7528\u6237\u662f\u5426\u5e0c\u671b\u5c06\u540c\u4e00\u5757\u4e2d\u7684\u6362\u884c\u7b26\u7528\\\\n\u8868\u793a\u3002\u4f8b\u5982\uff0c\u5982\u679c\u4fe1\u606f\u5757\u4e2d\u6709\u6362\u884c\uff0c\u5e94\u8be5\u7528\\\\n\u8fde\u63a5\u3002\u4f46\u5728\u8fd9\u4e2a\u4f8b\u5b50\u4e2d\uff0c\u4e24\u4e2a\u6bb5\u843d\u662f\u5206\u5f00\u7684\uff0c\u6240\u4ee5\u53ef\u80fd\u4f5c\u4e3a\u4e24\u4e2a\u4e0d\u540c\u7684\u5b57\u7b26\u4e32\u3002\\n\\n\u4e0d\u8fc7\u6839\u6
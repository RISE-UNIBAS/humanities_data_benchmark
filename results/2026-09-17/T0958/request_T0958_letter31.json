9\u91cc\u53d1\u4ef6\u4eba\u662f\u516c\u53f8\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u4e2a\u4eba\u7b7e\u540d\u3002\u5728\u4fe1\u7684\u672b\u5c3e\u6709\u7b7e\u540d\uff0c\u770b\u8d77\u6765\u50cf\u662f\u201cR. M.\u201d\u6216\u8005\u7c7b\u4f3c\u7684\u7f29\u5199\uff0c\u4f46\u53ef\u80fd\u65e0\u6cd5\u786e\u5b9a\u5177\u4f53\u4eba\u540d\uff0c\u6240\u4ee5\u53d1\u4ef6\u4eba\u53ef\u80fd\u53ea\u80fd\u586b\u516c\u53f8\u540d\u79f0\uff0c\u4f46\u6839\u636e\u793a\u4f8b\uff0c\u53d1\u4ef6\u4eba\u5e94\u8be5\u662f\u4e2a\u4eba\u540d\u5b57\uff0c\u6bd4\u5982\u4f8b\u5b50\u4e2d\u7684Lisa Simpson\u3002\u4f46\u8fd9\u91cc\u53ef\u80fd\u53d1\u4ef6\u4eba\u662f\u516c\u53f8\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u5c06\u516c\u53f8\u540d\u79f0\u4f5c\u4e3a\u53d1\u4ef6\u4eba\uff0c\u4f46\u7528\u6237\u8981\u6c42\u7684\u662f\u201csender_persons\u201d\uff0c\u5373\u4e2a\u4eba\u540d\u5b57\u3002\u8fd9\u65f6\u5019\u53ef\u80fd\u9700\u8981\u5224\u65ad\uff0c\u5982\u679c\u53d1\u4ef6\u4eba\u662f\u516c\u53f8\uff0c\u662f\u5426\u5e94\u8be5\u7559\u7a7a\u6216\u8005\u7528\u516c\u53f8\u540d\u3002\u4f46\u6839\u636e\u793a\u4f8b\uff0c\u53d1\u4ef6\u4eba\u662f\u4e2a\u4eba\uff0c\u6240\u4ee5\u53ef\u80fd\u8fd9\u91cc\u9700\u8981\u770b\u662f\u5426\u6709\u4e2a\u4eba\u7b7e\u540d\u3002\u5728\u4fe1\u7684\u672b\u5c3e\u6709\u7b7e\u540d\uff0c\u4f46\u53ef\u80fd\u65e0\u6cd5\u8fa8\u8ba4\uff0c\u6216\u8005\u53ef\u80fd\u662f\u516c\u53f8\u4ee3\u8868\u7684\u7b7e\u540d\uff0c\u6bd4\u5982\u201cR/M\u201d\u53ef\u80fd\u662f initials\uff0c\u4f46\u4e0d\u786e\u5b9a\u3002\u6240\u4ee5\u53ef\u80fd\u53d1\u4ef6\u4eba\u65e0\u6cd5\u786e\u5b9a\u5177\u4f53\u4eba\u540d\uff0c\u53ea\u80fd\u586b\u516c\u53f8\u540d\u79f0\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0c\u53ef\u80fd\u9700\u8981\u586b\u4e2a\u4eba\u540d\u5b57\uff0c\u6240\u4ee5\u8fd9\u91cc\u53ef\u80fd\u9700\u8981\u8bbe\u4e3anull\uff0c\u6216\u8005\u5982\u679c\u516c\u53f8\u540d\u4f5c\u4e3a\u53d1\u4ef6\u4eba\u7684\u8bdd\uff0c\u4f46\u7528\u6237\u793a\u4f8b\u4e2d\u662f\u4e2a\u4eba\u540d\u5b57\uff0c\u6240\u4ee5\u53ef\u80fd\u8fd9\u91cc\u53d1\u4ef6\u4eba\u65e0\u6cd5\u786e\u5b9a\uff0c\u8bbe\u4e3anull\uff1f\\n\\n\u4e0d\u8fc7\uff0c\u518d\u4ed4\u7ec6\u770b\uff0c\u4fe1\u4ef6\u7684\u5f00\u5934\u662fBasler Rheinschiffahrt-Aktiengesellschaft\uff0c\u8fd9\u662f\u53d1\u4ef6\u516c\u53f8\uff0c\u800c\u7b7e\u540d\u5904\u53ef\u80fd\u6709\u4e2a\u4eba\u7b7e\u540d\uff0c\u4f46\u56fe\u7247\u4e2d\u7684\u7b7e\u540d\u770b\u8d77\u6765\u50cf\u662f\u624b\u5199\u4f53\uff0c\u53ef\u80fd\u96be\u4ee5\u8fa8\u8ba4\u3002\u4f8b\u5982\uff0c\u7b7e\u540d\u90e8\u5206\u53ef\u80fd\u663e\u793a\u4e3a\u201cR. M.\u201d\u6216\u8005\u5176\u4ed6\u7f29\u5199\uff0c\u4f46\u65e0\u6cd5\u786e\u5b9a\u5177\u4f53\u4eba\u540d\u3002\u56e0\u6b64\uff0c\u53ef\u80fd\u53d1\u4ef6\u4eba\u53ea\u80fd\u586b\u516c\u53f8\u540d\u79f0\uff0c\u4f46\u6839\u636e\u7528\u6237\u7684\u8981\u6c42\uff0csender_persons\u5e94\u8be5\u662f\u4eba\u540d\uff0c\u6240\u4ee5\u53ef\u80fd\u8fd9\u91cc\u65e0\u6cd5\u786e\u5b9a\uff0c\u8bbe\u4e3anull\u3002\u6216\u8005\uff0c\u53ef\u80fd\u516c\u53f8\u4f5c\u4e3a\u53d1\u4ef6\u4eba\uff0c\u4f46\u7528\u6237\u793a\u4f8b\u4e2d\u662f\u4e2a\u4eba\uff0c\u6240\u4ee5\u53ef\u80fd\u9700\u8981\u8fdb\u4e00\u6b65\u5206\u6790\u3002\\n\\n\u63a5\u4e0b\u6765\u770b\u6536\u4ef6\u4eba\uff0c\u4fe1\u4e2d\u660e\u786e\u63d0\u5230\u201cHerrn Dr. Max Vischer, Basel, St. Albangraben.\u201d\uff0c\u6240\u4ee5\u6536\u4ef6\u4eba\u662fDr. Max Vischer\uff0c\u6240\u4ee5receiver_persons\u5e94\u8be5\u662f[\\\"Dr. Max Vischer\\\"]\u3002\\n\\n\u4fe1\u4ef6\u6807\u9898\u65b9\u9762\uff0c\u901a\u5e38\u6b63\u5f0f\u4fe1\u4ef6\u53ef\u80fd\u6ca1\u6709\u6807\u9898\uff0c\u4f46\u9700\u8981\u68c0\u67e5\u662f\u5426\u6709\u4e3b\u9898\u884c\u3002\u5728\u4fe1\u4e2d\uff0c\u5f00\u5934\u90e8\u5206\u6ca1\u6709\u660e\u663e\u7684\u6807\u9898\uff0c\u6b63\u6587\u5f00\u59cb\u76f4\u63a5\u662f\u5185\u5bb9\uff0c\u6240\u4ee5\u53ef\u80fd\u6ca1\u6709\u6807\u9898\uff0c\u56e0\u6b64letter_title\u8bbe\u4e3anull\u3002\\n\\n\u53d1\u9001\u65e5\u671f\u662f1928\u5e745\u67083\u65e5\uff0c\u6240\u4ee5send_date\u662f[\\\"1928-05-03\\\"]\u3002\\n\\n\u73b0\u5728\u9700\u8981\u786e\u8ba4\u53d1\u4ef6\u4eba\u3002\u4fe1\u4ef6\u7684\u4fe1\u5934\u662fBasler Rheinschiffahrt-Aktiengesellschaft\uff0c\u4f46\u53d1\u4ef6\u4eba\u5e94\u8be5\u662f\u5177\u4f53\u7684\u4e2a\u4eba\uff0c\u53ef\u80fd\u7531\u516c\u53f8\u7684\u4ee3\u8868\u7b7e\u7f72\u3002\u5728\u7b7e\u540d\u5904\uff0c\u6709\u624b\u5199\u7684\u7b7e\u540d\uff0c\u4f46\u53ef\u80fd\u65e0\u6cd5\u8fa8\u8ba4\u5177\u4f53\u540d\u5b57\uff0c\u6216\u8005\u53ef\u80fd\u662f\u516c\u53f8\u4ee3\u8868\u7684 initials\uff0c\u6bd4\u5982\u201cR/M\u201d\u53ef\u80fd\u5bf9\u5e94\u67d0\u4e2a\u4eba\uff0c\u4f46\u4e0d\u786e\u5b9a\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u5934\u4e0b\u65b9\u6709\u201cR/M\u201d\u7684\u7f29\u5199\uff0c\u53ef\u80fd\u4ee3\u8868\u53d1\u4ef6\u4eba\u7684 initials\uff0c\u4f46\u65e0\u6cd5\u786e\u5b9a\u5168\u540d\u3002\u56e0\u6b64\uff0c\u53ef\u80fd\u65e0\u6cd5\u786e\u5b9a\u5177\u4f53\u7684\u53d1\u4ef6\u4eba\u59d3\u540d\uff0c\u6240\u4ee5sender_persons\u8bbe\u4e3anull\u3002\u6216\u8005\uff0c\u5982\u679c\u516c\u53f8\u4f5c\u4e3a\u53d1\u4ef6\u4eba\uff0c\u4f46\u7528\u6237\u8981\u6c42\u7684\u662f\u4eba\u540d\uff0c\u6240\u4ee5\u53ef\u80fd\u8fd8\u662fnull\u3002\\n\\n\u7efc\u4e0a\uff0c\u63d0\u53d6\u7684\u4fe1\u606f\u5e94\u8be5\u662f\uff1a\\n\\nletter_title: null\uff08\u56e0\u4e3a\u6ca1\u6709\u660e\u786e\u6807\u9898\uff09\\nsend_date: [\\\"1928-05-03\\\"]\\nsender_persons: null\uff08\u56e0\u4e3a\u65e0\u6cd5\u786e\u5b9a\u5177\u4f53\u4eba\u540d\uff0c\u53ea\u6709\u516c\u53f8\u540d\uff09\\nreceiver_persons: [\\\"Dr. Max Vischer\\\"]\\n\\n\u4f46\u9700\u8981\u518d\u6b21\u68c0\u67e5\u662f\u5426\u6709\u5176\u4ed6\u7ebf\u7d22\u3002\u4f8b\u5982\uff0c\u5728\u4fe1\u4e2d\u63d0\u5230\u201cverfasst vom Redaktor und Schriftsteller Jean Richard Frey\u201d\uff0c\u4f46\u8fd9\u662f\u6587\u7ae0\u4f5c\u8005\uff0c\u4e0d\u662f\u53d1\u4ef6\u4eba\u3002\u53d1\u4ef6\u4eba\u662f\u516c\u53f8\uff0c\u6240\u4ee5\u53ef\u80fdsender_persons\u5e94\u4